//@version=6
// SWING_PRO — BUY  •  clean LIVE buy indicator (long side of the SWING_PRO_S strategy).
// Self-contained: computes the setup AND draws a bold BUY arrow. No wiring, no extra plots. Not financial advice.
indicator("SWING_PRO — BUY", shorttitle="SWING_BUY", overlay=true)

// ── 1) Overall trend ──
gT = "1) Overall trend"
useTrend     = input.bool(true,  "Only signal with the trend", group=gT)
useHTFTrend  = input.bool(true,  "Judge trend from a bigger timeframe", group=gT)
useAutoHTF   = input.bool(true,  "Pick that timeframe automatically", group=gT, tooltip="5-min chart × 15 = 75-min trend view.")
autoHtfMult  = input.int(15, "How much bigger? (× chart timeframe)", minval=2, maxval=60, step=1, group=gT)
htfTfManual  = input.timeframe("60", "Bigger timeframe (if automatic is off)", group=gT)
trendType    = input.string("EMA", "Trend line style", options=["EMA", "SMA"], group=gT)
trendLen     = input.int(50, "Trend line length (bars)", minval=10, maxval=200, step=5, group=gT)
useSlope     = input.bool(true,  "Skip flat, sideways markets", group=gT)
slopeLen     = input.int(3, "Tilt lookback (bars)", minval=1, group=gT)
slopeMinATR  = input.float(0.20, "How steep the trend must be", minval=0.0, maxval=1.0, step=0.05, group=gT)
useBuffer    = input.bool(false, "Require price to clear the line by a margin", group=gT)
bufferATR    = input.float(0.5, "Size of that margin (volatility units)", minval=0.0, step=0.1, group=gT)

// ── 2) MACD ──
gM = "2) Momentum (MACD) — leave as-is unless you know these"
fastLength   = input.int(12, "MACD fast", minval=1, group=gM)
slowLength   = input.int(26, "MACD slow", minval=1, group=gM)
signalLength = input.int(9,  "MACD signal", minval=1, group=gM)

// ── 3) RSI ──
gR = "3) Pressure (RSI)"
rsiLength    = input.int(14, "RSI lookback (bars)", minval=1, group=gR)
rsiLongLevel = input.int(52, "Buys need RSI above this", group=gR)

// ── 4) Impulse ──
gI = "4) Extra momentum confirmation (Impulse)"
useImpulse   = input.bool(true, "Require this extra confirmation", group=gI)
lengthMA     = input.int(34, "Smoothing length", minval=1, group=gI)
lengthSignal = input.int(9,  "Signal length", minval=1, group=gI)

// ── 5) Filters ──
gF = "5) Trade-quality filters"
useADX  = input.bool(true,  "Only signal when the trend is strong", group=gF)
adxLen  = input.int(14, "Trend-strength lookback (bars)", minval=1, group=gF)
adxMin  = input.int(20, "Minimum trend strength", minval=1, maxval=50, step=1, group=gF)
useVol  = input.bool(true,  "Require above-average volume", group=gF)
volLen  = input.int(20, "Volume average lookback (bars)", minval=1, group=gF)
volMult = input.float(1.5, "Volume must beat its average by", minval=0.0, maxval=4.0, step=0.1, group=gF)
atrLen  = input.int(14, "Volatility lookback (bars)", minval=1, group=gF)
useVolRegime = input.bool(false, "Skip very quiet periods", group=gF)
minAtrPct    = input.float(0.03, "Min movement (% of price)", minval=0.0, step=0.01, group=gF)

// ── 5b) Market alignment ──
gX = "5b) Follow the broader market"
useMarketFilter = input.bool(true, "Only buy when the market is up too", group=gX)
marketSym       = input.symbol("SPY", "Market index to follow", group=gX)
marketMaLen     = input.int(50, "Market trend length (bars)", minval=5, maxval=200, step=5, group=gX)

// ── 6) Anti-chase ──
gQ = "6) Anti-chase"
useCandle   = input.bool(true, "Signal bar must be green (close > open)", group=gQ)
useAvoidExt = input.bool(true, "Don't chase overbought (reversal signals only)", group=gQ)
obLevel     = input.int(72, "Skip late buys when RSI is above this", group=gQ)

// ── 7) Entry styles ──
gE = "7) Which buy setups to take"
useStateEntry = input.bool(true, "Style A: Trend (everything lines up)", group=gE)
usePullback   = input.bool(true, "Style B: Buy the dip", group=gE)
pullbackEMA   = input.int(9, "Fast line for dips & reversals", minval=1, group=gE)

// ── 8) Reversals ──
gV = "8) Reversal buys (against the trend)"
useReversals = input.bool(false, "Style C: Buy a downtrend turning up", group=gV)
revRsiFloor  = input.int(40, "Reversal needs RSI rising and above this", minval=1, maxval=60, group=gV)
revVolMult   = input.float(1.0, "Reversal volume must beat average by", minval=0.0, step=0.1, group=gV)

// ── 9) Timing & market hours ──
gS = "9) Timing"
confirmClose = input.bool(true, "Only signal after the bar closes (no repaint)", group=gS)
minBarsBetween = input.int(5, "Minimum bars between buy signals", minval=0, group=gS)

// ── 10) Display ──
gD     = "10) Display"
buyCol = input.color(#26a69a, "Buy marker colour", group=gD)
showBg = input.bool(false, "Tint the signal bar", group=gD)

// ── 11) Exits — close the long (sell-to-close) ──
gXe = "11) Exits — when to close the long"
showExits    = input.bool(true,  "Show EXIT markers", group=gXe)
exitOnMACD   = input.bool(true,  "Exit when momentum flips bearish (MACD)", group=gXe)
exitOnTrend  = input.bool(true,  "Exit when price closes back below the trend", group=gXe)
exitOnRSI    = input.bool(false, "Exit when RSI crosses below 50", group=gXe)
exitOnTarget = input.bool(true,  "Exit at ATR stop / profit target", group=gXe)
exitStopMult = input.float(1.5, "Stop distance (ATR)", minval=0.1, maxval=5.0, step=0.1, group=gXe)
exitRR       = input.float(2.0, "Profit target vs. risk", minval=0.1, maxval=6.0, step=0.1, group=gXe)
exitCol      = input.color(color.orange, "Exit marker colour", group=gXe)

// ── Functions ──
calc_smma(src, len) =>
    var float smma = na
    smma := na(smma[1]) ? ta.sma(src, len) : (smma[1] * (len - 1) + src) / len
    smma
calc_zlema(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    ema1 + (ema1 - ema2)

atr = ta.atr(atrLen)

// ── Higher timeframe ──
chartSec = timeframe.in_seconds(timeframe.period)
autoSec  = chartSec * autoHtfMult
htfAuto  = autoSec % 60 == 0 ? str.tostring(int(autoSec / 60)) : str.tostring(int(autoSec)) + "S"
htfTf    = useAutoHTF ? htfAuto : htfTfManual
localMA = trendType == "EMA" ? ta.ema(close, trendLen) : ta.sma(close, trendLen)
[htfMA, htfMAprev, htfATR] = request.security(syminfo.tickerid, htfTf, [localMA[1], localMA[1 + slopeLen], ta.atr(atrLen)[1]], lookahead=barmerge.lookahead_off)
trendMA = useHTFTrend ? htfMA : localMA
slopeATRval = useHTFTrend ? (htfATR > 0 ? (htfMA - htfMAprev) / htfATR : 0.0) : (atr > 0 ? (localMA - localMA[slopeLen]) / atr : 0.0)
slopeUp = slopeATRval >= slopeMinATR
slopeLongOK = not useSlope or slopeUp
buf  = useBuffer ? bufferATR * atr : 0.0
bull = not useTrend or close > trendMA + buf

// ── Market alignment ──
[mktClose, mktMA] = request.security(marketSym, timeframe.period, [close, ta.ema(close, marketMaLen)])
mktLongOK = not useMarketFilter or (mktClose > mktMA)

// ── Impulse MACD ──
srcImp = hlc3
hi  = calc_smma(high, lengthMA)
lo  = calc_smma(low,  lengthMA)
mi  = calc_zlema(srcImp, lengthMA)
md  = mi > hi ? mi - hi : mi < lo ? mi - lo : 0.0
sb  = ta.sma(md, lengthSignal)
impBull = not useImpulse or md > sb

// ── MACD + RSI ──
[macdValue, signalValue, macdHist] = ta.macd(close, fastLength, slowLength, signalLength)
macdBull = macdValue > signalValue
macdBear = macdValue < signalValue
rsiValue  = ta.rsi(close, rsiLength)
rsiLongOK = rsiValue > rsiLongLevel

// ── Filters ──
[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)
adxOK = not useADX or adxValue >= adxMin
volAvg = ta.sma(volume, volLen)
volOK  = not useVol or na(volume) or volume >= volMult * volAvg
inSess = true  // runs 24h — no session restriction
atrPctOK = not useVolRegime or (close > 0 and (atr / close * 100.0) >= minAtrPct)
filtersOK = adxOK and volOK and inSess and atrPctOK

// ── Guards ──
candleBuyOK    = not useCandle or close > open
notExtremeLong = not useAvoidExt or rsiValue < obLevel

// ── Long signal logic ──
longState = bull and slopeLongOK and macdBull and impBull and rsiLongOK and filtersOK
longTrig  = longState and not longState[1]
emaFast  = ta.ema(close, pullbackEMA)
pullLong = usePullback and bull and slopeLongOK and macdBull and impBull and rsiLongOK and filtersOK and ta.crossover(close, emaFast)
priceBelow = close < trendMA - buf
macdRevUp  = macdHist > macdHist[1]
rsiTurnUp  = rsiValue > rsiValue[1] and rsiValue > revRsiFloor
revVolOK   = not useVol or na(volume) or volume >= revVolMult * volAvg
revFiltersOK = revVolOK and inSess and atrPctOK
revLong  = useReversals and priceBelow and ta.crossover(close, emaFast) and macdRevUp and rsiTurnUp and rsiValue < obLevel and revFiltersOK
stLong   = useStateEntry and longTrig
trendBuy = (stLong or pullLong) and mktLongOK
revBuy   = revLong and notExtremeLong
inLate = false  // runs 24h — never mute by time of day
confirmed = not confirmClose or barstate.isconfirmed

// Raw signal, then spacing so only the first of a cluster prints.
rawBuy = confirmed and (trendBuy or revBuy) and candleBuyOK and not inLate
var int lastBuyBar = na
canFire = na(lastBuyBar) or (bar_index - lastBuyBar) >= minBarsBetween
buySignal = rawBuy and canFire
if buySignal
    lastBuyBar := bar_index

// ── Exit tracking: after a BUY, confirm and mark where to close the long ──
var bool  inLong    = false
var float longEntry = na
var float longStop  = na
var float longTgt   = na
if buySignal
    inLong    := true
    longEntry := close
    longStop  := close - exitStopMult * atr
    longTgt   := close + exitRR * exitStopMult * atr

condExit = (exitOnMACD and macdBear) or (exitOnTrend and close < trendMA) or (exitOnRSI and ta.crossunder(rsiValue, 50))
stopHit  = exitOnTarget and not na(longStop) and low  <= longStop
tgtHit   = exitOnTarget and not na(longTgt)  and high >= longTgt
exitLong = inLong and confirmed and not buySignal and (condExit or stopHit or tgtHit)
if exitLong
    inLong := false

// ── Plots: BUY entry + EXIT (close the long) ──
plotshape(buySignal, title="Buy", style=shape.labelup, location=location.belowbar, color=buyCol, text="BUY", textcolor=color.white, size=size.large)
plotshape(showExits and exitLong, title="Exit Long", style=shape.xcross, location=location.abovebar, color=exitCol, text="EXIT", textcolor=exitCol, size=size.small)
bgcolor(showBg and buySignal ? color.new(buyCol, 85) : na, title="Buy tint")
alertcondition(buySignal, "Swing Buy",  "[SWING_BUY] BUY {{ticker}} @ {{close}}")
alertcondition(exitLong,  "Swing Exit Long", "[SWING_BUY] EXIT LONG {{ticker}} @ {{close}}")
