// ═══ iAPE MR (formerly SWING_PRO MR) — Mean-Reversion (Strategy #2) ═════════════════════════════════════
// The portfolio's SECOND engine — deliberately ANTI-CORRELATED with iAPE momentum.
// Where momentum buys strength and lets winners run, this buys panic and sells the
// snapback. Two uncorrelated edges stack: when one bleeds, the other tends to feed.
//
// THE IDEA (buy oversold dips inside an uptrend):
//   ENTRY  — close is ABOVE its 200-day average (only dip-buy in uptrends) AND
//            RSI(3) < 15 (a sharp, short-term washout). Long only.
//   EXIT   — the snapback IS the profit, so take it fast:
//            • first close back ABOVE the 10-day average  (mean touched → done), or
//            • 10 sessions elapsed with no snapback        (time stop → move on), or
//            • price falls 3×ATR below entry               (disaster stop → rarely fires)
//   No 3R target here — mean reversion's edge is a high hit-rate on small, quick moves
//   (validated ~64% win), the mirror image of momentum's 37%-win / big-winner profile.
//
// VALIDATED (mean_rev.py portfolio engine, 3 market generations, daily bars):
//   PF 1.36 / 1.22 / 1.21 by decade · 2,809 trades · ~64% win · adopted on the first
//   pre-registered shot. Currently in live PAPER shadow audition (no real money).
//
// ⚠ PORTFOLIO-FIDELITY CAVEAT — READ THIS:
//   The validated engine is a PORTFOLIO: it caps concurrent positions at 10 and, when
//   more than 10 symbols are oversold at once (common in selloffs), takes only the
//   MOST oversold. TradingView runs ONE symbol per chart and CANNOT see the other 21
//   or enforce that cap. So this per-symbol backtest shows EVERY signal on this ticker —
//   it will run a bit RICHER than the capped portfolio. Judge it across your whole
//   watchlist, and treat the portfolio's 1.2-1.4 PF (not one chart's number) as truth.
//   → Open on a DAILY chart (this is a daily system). Not financial advice.
//@version=6
strategy("iAPE MR — Mean-Reversion", shorttitle="iAPE_MR", overlay=true,
     max_labels_count=500, pyramiding=0, calc_on_every_tick=false,
     initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.01, slippage=1)

// ── 1) Entry ───────────────────────────────────────────────────────────────────────────
g1 = "1) Entry — buy the oversold dip inside an uptrend"
rsiLen    = input.int(3, "RSI length (short & sharp)", minval=1, group=g1, tooltip="RSI(3) is a fast washout gauge, not the usual RSI(14). Lower = only the sharpest 1-3 day drops qualify.")
rsiEntry  = input.float(15.0, "Buy when RSI is below", minval=1, maxval=50, step=1, group=g1, tooltip="Deep oversold. 15 is the validated level; higher = more (shallower) entries.")
trendLen  = input.int(200, "Only in uptrends: price above this average", minval=20, maxval=400, step=10, group=g1, tooltip="The regime filter. Dip-buying only works while the longer trend is up — below the 200-day, a dip is often just the start of a decline.")
confirmClose = input.bool(true, "Only act after the bar closes (no repainting)", group=g1)

// ── 2) Exit — take the snapback fast ───────────────────────────────────────────────────
g2 = "2) Exit — the bounce is the profit, don't overstay"
exitMaLen = input.int(10, "Exit on first close above this average", minval=2, maxval=50, step=1, group=g2, tooltip="The mean it's reverting to. First close back above it = the snapback happened, bank it.")
timeStop  = input.int(10, "Give up after this many sessions", minval=1, maxval=40, group=g2, tooltip="If the bounce hasn't come by now, the setup failed — free the capital.")
atrLen    = input.int(14, "Volatility lookback for the disaster stop", minval=1, group=g2)
stopMult  = input.float(3.0, "Disaster stop distance (×ATR — wide, rarely fires)", minval=0.5, maxval=8.0, step=0.5, group=g2, tooltip="A safety net, NOT trade management. It sits far away so normal noise never hits it; it only saves you if a dip becomes a crash.")

// ── 3) Display ─────────────────────────────────────────────────────────────────────────
g3 = "3) Display"
showSignals = input.bool(true, "Show BUY / EXIT labels", group=g3)
showLevels  = input.bool(true, "Draw the trend, exit-mean & stop lines", group=g3)
showDash    = input.bool(true, "Show plain-English dashboard", group=g3)
buyCol   = input.color(#26a69a, "Buy colour", group=g3)
exitCol  = input.color(#f2a900, "Exit colour", group=g3)

// ── Indicators ─────────────────────────────────────────────────────────────────────────
trendMA = ta.sma(close, trendLen)
exitMA  = ta.sma(close, exitMaLen)
rsiV    = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)

confirmed = not confirmClose or barstate.isconfirmed
regimeOK  = not na(trendMA) and close > trendMA
washout   = not na(rsiV) and rsiV < rsiEntry
goLong    = confirmed and regimeOK and washout and strategy.position_size == 0

// ── Position bookkeeping ────────────────────────────────────────────────────────────────
var float entryRef  = na
var float stopLevel = na
var int   barsHeld  = 0

inPos = strategy.position_size > 0
barsHeld := inPos ? barsHeld + 1 : 0   // counts closes since the position opened (fill bar = 1)

// condition exits (checked at close, fill next open — like the validated engine)
meanTouch = inPos and not na(exitMA) and close > exitMA
timedOut  = inPos and barsHeld >= timeStop

buy      = false
exitNow  = false

if confirmed
    if inPos and (meanTouch or timedOut)
        strategy.close("MR", comment = meanTouch ? "mean" : "time")
        exitNow := true
    if goLong
        strategy.entry("MR", strategy.long)
        buy := true
        entryRef  := close
        stopLevel := close - stopMult * atr
        barsHeld  := 0

// disaster stop — anchored to the signal close, lives while in the trade
if inPos and not na(stopLevel)
    strategy.exit("MR-stop", from_entry = "MR", stop = stopLevel)

// ── Chart output ────────────────────────────────────────────────────────────────────────
plot(showLevels ? trendMA : na, "Trend (200)", color = color.new(color.gray, 30), linewidth = 2)
plot(showLevels ? exitMA  : na, "Exit mean (10)", color = color.new(color.teal, 40))
plot(showLevels and inPos ? stopLevel : na, "Disaster stop", color = color.new(color.red, 40), style = plot.style_linebr)

plotshape(showSignals and buy,     "BUY",  shape.labelup,   location.belowbar, buyCol,  text = "BUY",  textcolor = color.white, size = size.small)
plotshape(showSignals and exitNow, "EXIT", shape.labeldown, location.abovebar, exitCol, text = "EXIT", textcolor = color.white, size = size.small)

// ── Alerts ──────────────────────────────────────────────────────────────────────────────
alertcondition(buy,     "MR Buy",  "[iAPE_MR] BUY {{ticker}} @ {{close}} (RSI oversold in uptrend)")
alertcondition(exitNow, "MR Exit", "[iAPE_MR] EXIT {{ticker}} @ {{close}} (snapback / time stop)")

// hidden connector — a momentum chart could read this to avoid fighting a MR position
plot(inPos ? 1 : 0, "→ In MR position", color = color.new(color.gray, 100), display = display.none)

// ── Plain-English dashboard ─────────────────────────────────────────────────────────────
var table dash = table.new(position.bottom_center, 2, 8, frame_width = 1,
     frame_color = color.new(color.gray, 40), border_width = 1, border_color = color.new(color.gray, 80))

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.white, 15), text_halign = text.align_right, bgcolor = color.new(color.black, 20), text_size = size.normal)
    table.cell(dash, 1, r, v, text_color = vc, text_halign = text.align_left, bgcolor = color.new(color.black, 35), text_size = size.normal)

if barstate.islast and showDash
    grey  = color.new(color.white, 35)
    green = color.new(#26a69a, 0)
    red   = color.new(#ef5350, 0)

    table.cell(dash, 0, 0, "iAPE MR", text_color = color.white, bgcolor = color.new(color.purple, 15), text_size = size.normal)
    table.cell(dash, 1, 0, syminfo.ticker + "  ·  mean-reversion  ·  " + timeframe.period, text_color = color.white, bgcolor = color.new(color.purple, 15), text_size = size.normal)

    // what the setup is doing right now
    string nowTxt = inPos ? "HOLDING — waiting for snapback (held " + str.tostring(barsHeld) + " / " + str.tostring(timeStop) + " sessions)" :
         regimeOK ? "Armed & watching — RSI " + str.tostring(rsiV, "#.#") + " (buys under " + str.tostring(rsiEntry, "#") + ")" :
         "Stand aside — price below its " + str.tostring(trendLen) + "-day average (no dip-buying in downtrends)"
    f_row(1, "Right now", nowTxt, inPos ? green : grey)

    f_row(2, "Open trade P&L", inPos ? (strategy.openprofit >= 0 ? "+" : "") + str.tostring(strategy.openprofit, "#,###.##") + " USD" : "—",
         strategy.openprofit > 0 ? green : strategy.openprofit < 0 ? red : grey)

    tot = strategy.closedtrades
    wr  = tot > 0 ? 100.0 * strategy.wintrades / tot : na
    f_row(3, "Trades on this chart", str.tostring(tot) + (tot > 0 ? "  (won " + str.tostring(wr, "#.#") + "% — MR should be HIGH, ~64%)" : ""), grey)

    gp = strategy.grossprofit
    gl = strategy.grossloss
    pf = gl > 0 ? gp / gl : na
    f_row(4, "Profit factor", na(pf) ? "—" : "made $" + str.tostring(pf, "#.##") + " for every $1 lost",
         na(pf) ? grey : pf >= 1.2 ? green : pf >= 0.95 ? grey : red)

    np = strategy.netprofit
    f_row(5, "Net result", (np >= 0 ? "+" : "") + str.tostring(np, "#,###") + " USD  (" + str.tostring(100 * np / strategy.initial_capital, "#.##") + "%)",
         np > 0 ? green : np < 0 ? red : grey)

    // timeframe honesty — MR was validated on DAILY
    string tfTxt = timeframe.isdwm ? "DAILY — VALIDATED (3 decades, PF 1.2-1.4 portfolio; this ONE chart runs richer, see header)" :
         "NOT daily — MR-1 was validated on DAILY bars only. Switch to a daily chart."
    f_row(6, "This timeframe", tfTxt, timeframe.isdwm ? green : red)

    string verdict = tot < 30 ? "Too few trades to judge — load more history or scan the watchlist" :
         na(pf) ? "No losing trades yet — sample too small" :
         pf >= 1.2 ? "Profitable here — but portfolio cap means live results run lower; verify across symbols" :
         pf >= 0.95 ? "About breakeven on this chart" :
         "Losing on this chart — do not trade these settings live"
    f_row(7, "Plain verdict", verdict, tot < 30 ? grey : na(pf) ? grey : pf >= 1.2 ? green : pf >= 0.95 ? grey : red)
