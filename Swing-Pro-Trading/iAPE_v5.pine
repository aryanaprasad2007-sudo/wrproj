// © @Apeaverage & @SXDXST_FB6 (Impulse MACD) • Refined by Akash (SMA/RSI/MACD)
//
// ═══ iAPE v5 — TIMEFRAME-INVARIANT SIGNAL ENGINE (weekly) ═══════════════════════════════
//
// WHAT THIS IS: a re-architecture of iAPE v4's engine so that ALL signal computation runs
// on ONE configurable signal timeframe (default: W), independent of the chart. The chart
// timeframe only affects rendering granularity. Run the same script on 1W / 1D / 5m charts
// and the parity table (top right) proves whether they saw the same trades.
//
// WHAT THIS IS NOT: this is NOT the momentum+MR merge "v5" that was tested and rejected on
// 2026-07-30 (portfolio switching lives in Python, not Pine). No MR, no regime gating, no
// new indicator logic — this is v4's engine, faithfully evaluated on weekly bars, i.e. what
// v4 computes on a 1W chart today (local weekly EMA50 trend, weekly gates, weekly candle).
//
// PARITY DESIGN (the three things that make cross-chart parity possible):
//   1. Signals evaluate ONLY when a signal-TF bar completes, detected on every chart as the
//      chart bar whose close time equals the SIGNAL-TF BAR'S OWN close time as reported by
//      the engine from inside the signal-TF context. On a 1W chart that is every bar; on 1D
//      it is Friday; on a 5m RTH chart it is the 15:55-16:00 bar — the SAME instant, and the
//      chart's close there IS the weekly close. (v5.1: v5.0 compared against the chart-side
//      calendar function time_close(sigTF); its dwm conventions are undocumented and it was
//      DEAD on 1D charts — zero fires, zero trades. Both timestamps now come from the same
//      data pipeline. Gate health is printed in the parity table.)
//   2. process_orders_on_close=true, so entries and exits fill at that shared close print.
//   3. Exits are SIGNAL-TF-CONFIRMED MARKET EXITS (stop/target breach tested on the
//      completed weekly bar; stop wins a same-week tie — deterministic). Resting intrabar
//      stop/limit orders were REMOVED: the broker emulator fills those from chart-granularity
//      data (5m bars vs weekly OHLC + path heuristic), which makes cross-chart PnL parity
//      structurally impossible. This is a deliberate behavioral change from v4 — see changelog.
//
// PARITY SCOPE (honest limits):
//   • What can match exactly across charts: signal fingerprint, closed-trade count, entry/exit
//     fills, net profit. What can NEVER match: Strategy Tester drawdown / Sharpe / run-ups —
//     those are computed per CHART bar and differ by construction. Judge parity on the table.
//   • The 5m chart holds roughly a year of bars: with the 2010 window it will show WINDOW
//     CLIPPED (correct, not a bug). To include 5m in the parity test, re-pin the window on
//     ALL charts to a range the 5m chart actually covers.
//   • Chart preconditions: regular-session charts (extended hours OFF), identical dividend-
//     adjustment (ADJ) setting on all charts, chart TF <= signal TF.
//   • Self-audits in the table: MERGE LAG fires if TradingView delivers confirmed weekly
//     values later than the documented end-of-period merge; CALENDAR fires if week-end
//     detection ever disagrees with week-start counts (undocumented holiday behavior of
//     time_close). If either shows, the fingerprint is not comparable — report it.
//
// VALIDATION STATUS: UNVALIDATED. v5 fills at the signal close (v4 filled next-bar open),
// exits at weekly closes (v4 exited intrabar at the level) — so NO v4/v2.2 backtest or
// forward-test evidence transfers to v5. Treat every number this script prints as a NEW,
// unaudited engine until it earns its own evidence. Not financial advice.
//@version=6
strategy("iAPE v5 — TF-invariant momentum (weekly signal engine)", shorttitle="iAPE_v5", overlay=true,
     max_labels_count=500, pyramiding=0,
     calc_on_every_tick=false, process_orders_on_close=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.01, slippage=1,
     use_bar_magnifier=false, dynamic_requests=true)
// initial_capital cannot be a Pine input by language design — override it in Properties.
// Percent-of-equity sizing is deliberately absent (it compounds differently per trade count
// and breaks cross-chart comparison); qty is the fixed-share input below.

// ── Signal engine timeframe ────────────────────────────────────────────────────────────────
gSE = "Signal Engine"
sigTF = input.timeframe("W", "Signal timeframe", group=gSE, tooltip="Every indicator and every entry/exit decision is computed on completed bars of THIS timeframe, regardless of the chart. Default W = the weekly engine (the 2026-07-30 timeframe-plateau finding). The chart must be at or below this timeframe.")
gateMode = input.string("Strict (close-match)", "Action gate", options=["Strict (close-match)", "Arrival (diagnostic)"], group=gSE, tooltip="Strict (default): act only on the chart bar whose close time equals the signal-TF bar's own close time — the parity-correct, live-safe gate.\n\nArrival (diagnostic): act on the historical bar where a new completed signal-TF evaluation first appears, whatever its timestamp. Use ONLY if the parity table shows GATE DEAD (a feed whose daily and weekly bar timestamps disagree). Historical bars only — it never acts on the live bar, because realtime security returns the DEVELOPING signal-TF bar; do not trade or alert from this mode.")

// ── 1) Direction & mode ────────────────────────────────────────────────────────────────────
g1 = "1) Direction & mode"
tradeDir = input.string("Buys only (long)", "Trade direction", options=["Buys only (long)", "Both", "Sells only (short)"], group=g1, tooltip="Validated default is LONGS ONLY: across every tested configuration the short side lost money. Switch only to re-test, not to trade on faith.")
mode = input.string("Validated (v2.2)", "Mode", options=["Validated (v2.2)", "Strict - higher win%? (UNVALIDATED)"], group=g1, tooltip="Same indicators in both modes — only thresholds change.\n\nVALIDATED: the v2.2 gate set.\n\nSTRICT: tighter gates (ADX 25+, slope 0.30+, RSI 55+). Never validated.\n\nv4's Comfort mode (partial/breakeven/2R) is GONE in v5: those are intrabar-order constructs and cannot exist under deterministic weekly-confirmed exits.")
minBarsBetween = input.int(1, "Minimum signal-TF bars between signals", minval=0, group=g1, tooltip="Cooldown counted in SIGNAL-timeframe bars (weeks by default), not chart bars — chart-bar counting would break timeframe invariance. Default 1 = inert, as in v4.")
showSignals = input.bool(true, "Show BUY / SELL / EXIT markers", group=g1, tooltip="Entry and exit markers are drawn with plotshape on the chart bar where the signal-TF bar completed.")

// ── 2) Trend regime (computed on the signal TF) ────────────────────────────────────────────
g2 = "2) Trend regime — ATR-normalised slope on the signal timeframe"
trendType   = input.string("EMA", "Trend line style", options=["EMA", "SMA"], group=g2, tooltip="Moving-average type for the signal-TF trend line. v4 default: EMA.")
trendLen    = input.int(50, "Trend line length (signal-TF bars)", minval=10, maxval=200, step=5, group=g2, tooltip="50 weekly bars by default — the same local-trend construction v4 uses on daily+ charts, now pinned to the signal TF. The intraday ×15 auto-HTF machinery from v4 is gone: the signal TF IS the regime timeframe.")
useSlope    = input.bool(true, "Skip flat, sideways markets (KEEP ON — validated)", group=g2, tooltip="The single most protective filter in the v2 ablation (removing it turned -$144 into -$1,802). Evidence was measured at 5m/daily; the weekly engine inherits the construction, not the evidence.")
slopeLen    = input.int(3, "Tilt lookback (signal-TF bars)", minval=1, group=g2, tooltip="Slope = (trendline now − trendline this many signal-TF bars ago) / ATR.")
slopeMinATR = input.float(0.20, "How steep the trend must be", minval=0.0, maxval=1.0, step=0.05, group=g2, tooltip="Minimum ATR-normalised slope. Strict mode raises the floor to 0.30.")
showTrend   = input.bool(true, "Show the trend line", group=g2, tooltip="Plotted as a stepline so you can see it hold its weekly value across intraday bars — visual proof the signal engine is not recomputing per chart bar.")

// ── 3) Momentum gates ──────────────────────────────────────────────────────────────────────
g3 = "3) Momentum gates — each togglable for A/B testing"
useMACDGate  = input.bool(true, "Require MACD agreement", group=g3, tooltip="MACD, Impulse and RSI largely triple-vote the same information; kept for structure, as in v4.")
fastLength   = input.int(12, "MACD fast", minval=1, group=g3, tooltip="MACD fast EMA length, in signal-TF bars.")
slowLength   = input.int(26, "MACD slow", minval=1, group=g3, tooltip="MACD slow EMA length, in signal-TF bars.")
signalLength = input.int(9, "MACD signal", minval=1, group=g3, tooltip="MACD signal EMA length, in signal-TF bars.")
useImpulse   = input.bool(true, "Require Impulse MACD agreement", group=g3, tooltip="Impulse MACD (SMMA band + ZLEMA) computed on signal-TF bars.")
lengthMA     = input.int(34, "Impulse smoothing length", minval=1, group=g3, tooltip="SMMA/ZLEMA length for the Impulse MACD, in signal-TF bars.")
lengthSignal = input.int(9, "Impulse signal length", minval=1, group=g3, tooltip="SMA length of the Impulse signal line, in signal-TF bars.")
useRSIGate   = input.bool(true, "Require RSI pressure band", group=g3, tooltip="RSI computed on signal-TF closes.")
rsiLength    = input.int(14, "RSI lookback", minval=1, group=g3, tooltip="RSI length, in signal-TF bars.")
rsiLongLevel  = input.int(52, "Buys need RSI above", group=g3, tooltip="Strict mode raises this to at least 55.")
rsiShortLevel = input.int(48, "Sells need RSI below", group=g3, tooltip="Strict mode lowers this to at most 45.")

// ── 4) Trade-quality filters ───────────────────────────────────────────────────────────────
g4 = "4) Trade-quality filters"
useADX  = input.bool(true, "Only trade when the trend is strong (ADX)", group=g4, tooltip="ADX computed on signal-TF bars.")
adxLen  = input.int(14, "ADX lookback", minval=1, group=g4, tooltip="DMI/ADX length, in signal-TF bars.")
adxMin  = input.int(20, "Minimum ADX", minval=1, maxval=50, step=1, group=g4, tooltip="Strict mode raises the floor to 25.")
useMarketFilter = input.bool(true, "Only trade with the overall market (KEEP ON — validated)", group=g4, tooltip="SPY vs its EMA, computed on SIGNAL-TF bars — faithful to what v4 computes on a 1W chart (SPY vs 50-WEEK EMA). Be aware this weekly filter is near-vestigial: it stays one-sided for years at a stretch. The v2 ablation evidence for this gate was measured at 5m.")
marketSym   = input.symbol("SPY", "Market index to follow", group=g4, tooltip="Requested at the signal timeframe inside the signal engine (v6 nested request).")
marketMaLen = input.int(50, "Market trend length (signal-TF bars)", minval=5, maxval=200, step=5, group=g4, tooltip="EMA length for the market filter, in signal-TF bars.")
useCandle = input.bool(true, "Entry bar must match — green to buy, red to sell (KEEP ON — validated)", group=g4, tooltip="Applies to the SIGNAL-TF candle: with a weekly engine the whole WEEK must close green to buy — a much stricter gate than v4's 5m/daily candle. Faithful to v4-on-1W.")
useSess = input.bool(false, "Only trade during set hours", group=g4, tooltip="Evaluated in the signal-TF context. TradingView does not document session tests on weekly bars — leave OFF on a weekly engine (default).")
sess    = input.session("0930-1600", "Trading hours (exchange time)", group=g4, tooltip="Only used if the session filter is on.")

// ── 5) Entries ─────────────────────────────────────────────────────────────────────────────
g5 = "5) Entries"
useStateEntry = input.bool(true, "Entry A: Trend (everything lines up)", group=g5, tooltip="Fires on the off→on edge of the full confluence state, detected on signal-TF bars.")
usePullback   = input.bool(true, "Entry B: Buy the dip / sell the bounce", group=g5, tooltip="Fires when the state holds and the signal-TF close crosses the fast line.")
pullbackEMA   = input.int(9, "Fast line for dips & bounces (signal-TF bars)", minval=1, group=g5, tooltip="EMA length for Entry B, in signal-TF bars (9 weeks by default).")
allowReentry  = input.bool(true, "Allow trading the same direction again", group=g5, tooltip="As in v4. Note v5's cooldown counts accepted SIGNAL events (engine-side, position-independent); with this OFF, v4 would not have reset its cooldown on a filtered re-signal — a micro-difference documented in the changelog.")
longWinsOnConflict = input.bool(false, "If buy & sell trigger same bar, take the buy", group=g5, tooltip="Off (recommended): skip contradictory signal-TF bars entirely. Faithful to v4, including v4's quirk that the short side is suppressed on conflict in both settings.")

// ── 6) Exits & risk (signal-TF-confirmed) ──────────────────────────────────────────────────
g6 = "6) Exits & risk — tested on COMPLETED signal-TF bars, filled at their close"
exitOnTarget = input.bool(true, "Exit at the stop-loss / profit target", group=g6, tooltip="v5 semantics: the stop/target levels are tested against each COMPLETED signal-TF bar's low/high, and the exit fills at that bar's CLOSE (market order). If both levels are breached inside one signal-TF bar, the STOP wins — a deterministic rule, unlike v4's chart-granularity emulator fills. This is the change that makes cross-chart PnL parity possible; it also means there is NO intra-week protection and gap-throughs fill at the weekly close.")
atrLen      = input.int(14, "Volatility lookback (signal-TF bars)", minval=1, group=g6, tooltip="ATR length on signal-TF bars. A weekly ATR is roughly 5-15× a daily one — risk per trade scales accordingly.")
atrStopMult = input.float(1.5, "Stop distance (volatility units)", minval=0.1, maxval=5.0, step=0.1, group=g6, tooltip="Fallback stop distance in signal-TF ATRs; also floors the structural stop at half this distance.")
rrRatio     = input.float(3.0, "Profit target vs. risk (3 — validated)", minval=0.1, maxval=6.0, step=0.1, group=g6, tooltip="v2.2 exit-sweep winner (measured under v4 fill semantics; carries over as construction, not as evidence).")
useStructStop  = input.bool(true, "Put the stop just past the recent swing", group=g6, tooltip="Stop anchored below the signal-TF swing low (longs) / above the swing high (shorts).")
structLookback = input.int(10, "Swing lookback (signal-TF bars)", minval=2, maxval=50, step=1, group=g6, tooltip="10 weekly bars = the ~quarterly swing structure.")
structBufATR   = input.float(0.25, "Extra cushion past the swing", minval=0.0, maxval=2.0, step=0.05, group=g6, tooltip="Cushion beyond the swing, in signal-TF ATRs.")
exitOnTrend = input.bool(false, "Exit when the signal-TF close crosses the trend line (OFF — validated)", group=g6, tooltip="v2.2 exit sweep: protective exits clipped the big winners. Kept togglable for A/B, tested on completed signal-TF bars.")
exitOnMACD  = input.bool(false, "Exit when MACD flips against you (OFF — validated)", group=g6, tooltip="Measured money-loser in the v2 ablation. Tested on completed signal-TF bars.")
exitOnRSI   = input.bool(false, "Exit when RSI crosses back through 50", group=g6, tooltip="Optional, off by default, tested on completed signal-TF bars.")
showRiskLines = input.bool(true, "Draw live stop & target lines while in a trade", group=g6, tooltip="The active stop/target levels, held flat between signal-TF closes.")
showExits     = input.bool(true, "Show EXIT / COVER markers", group=g6, tooltip="Drawn on the chart bar after the exit fill registers in the position size.")

// ── 7) Backtest window ─────────────────────────────────────────────────────────────────────
gW = "Window"
startDate = input.time(timestamp("01 Apr 2010 00:00 -0500"), "Backtest start", group=gW, tooltip="PRI's IPO date (no data exists earlier). Note: -0500 is EST notation during a DST period, i.e. 11 PM Mar 31 ET — harmless, the first session is Apr 1 09:30. The window is tested against the SIGNAL-TF bar's open time (not the chart bar's), so the same weekly bars are in-window on every chart — chart-time gating would let a mid-week boundary include a week on one chart and exclude it on another.")
endDate   = input.time(timestamp("01 Jan 2100 00:00 -0500"), "Backtest end", group=gW, tooltip="Entries stop and any open position is force-flattened at the first signal-TF close outside the window, so trade counts cannot diverge by one across charts.")

// ── 8) Sizing ──────────────────────────────────────────────────────────────────────────────
gQ = "Sizing"
qtyShares = input.int(100, "Shares per trade (fixed)", minval=1, group=gQ, tooltip="Fixed share count passed to every entry. Percent-of-equity is deliberately not offered: it compounds differently at different trade counts and breaks cross-chart comparison. Initial capital ($100k default) is set in Properties (Pine cannot expose it as an input).")

// ── 9) Display ─────────────────────────────────────────────────────────────────────────────
g8 = "9) Display & dashboard"
showParity = input.bool(true, "Show parity diagnostics table (top right)", group=g8, tooltip="The acceptance test: if 1W, 1D and 5m show the same fingerprint, trade count and net profit, parity holds. Warning rows tell you exactly where it broke.")
showDash   = input.bool(true, "Show plain-English dashboard (bottom)", group=g8, tooltip="Compact position/result read-out, as in v4.")
showHud    = input.bool(true, "Show fallback HUD label (diagnostics)", group=g8, tooltip="A one-line label next to the last bar with gate fires / fingerprint / trades. Deliberately a LABEL, not a table — it renders even when tables don't (observed on some panes 2026-07-31).")
showGateShade = input.bool(true, "Shade gate-fire bars", group=g8, tooltip="Faint background stripe on every chart bar where the signal-TF close gate fired. The fastest possible answer to 'is the gate alive on this chart' — a weekly engine on a daily chart should show one stripe per week.")
showRegime = input.bool(true, "Show market regime (label only — changes nothing)", group=g8, tooltip="The frozen switch-policy classifier (SPY above a rising 50-day SMA, prior daily close). READ-OUT ONLY — wired into nothing; combining the engines was measured and LOST on a single symbol (2026-07-30).")
buyMarkerCol  = input.color(#26a69a, "Buy colour", group=g8, tooltip="Marker colour for entries (long).")
sellMarkerCol = input.color(#e53935, "Sell colour", group=g8, tooltip="Marker colour for short entries.")
exitMarkerCol = input.color(color.orange, "Exit / cover colour", group=g8, tooltip="Marker colour for exits.")
dashSizeStr = input.string("Normal", "Table text size", options=["Small", "Normal", "Large"], group=g8, tooltip="Applies to both tables.")
dashSize = dashSizeStr == "Small" ? size.small : dashSizeStr == "Large" ? size.large : size.normal

// ── Mode-effective thresholds (Strict tightens gates) ──────────────────────────────────────
isStrict = mode == "Strict - higher win%? (UNVALIDATED)"
slopeMinATR_e   = isStrict ? math.max(slopeMinATR, 0.30) : slopeMinATR
rsiLongLevel_e  = isStrict ? math.max(rsiLongLevel, 55) : rsiLongLevel
rsiShortLevel_e = isStrict ? math.min(rsiShortLevel, 45) : rsiShortLevel
adxMin_e        = isStrict ? math.max(adxMin, 25) : adxMin
allowLongs  = tradeDir != "Sells only (short)"
allowShorts = tradeDir != "Buys only (long)"

// ── Fingerprint constants (named, not magic) ───────────────────────────────────────────────
int FP_MOD  = 1000000007  // prime modulus keeps the running hash inside exact-int range
int FP_MULT = 31          // classic polynomial-rolling-hash multiplier

// ── Helper functions (identical math to v4) ────────────────────────────────────────────────
calc_smma(src, len) =>
    var float smma = na
    smma := na(smma[1]) ? ta.sma(src, len) : (smma[1] * (len - 1) + src) / len
    smma
calc_zlema(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    ema1 + (ema1 - ema2)

// ── THE SIGNAL ENGINE — every series in here is a SIGNAL-TF series ─────────────────────────
// This function is only ever evaluated inside request.security(sigTF), so close/high/low/
// bar_index/time inside it are signal-TF values. Faithful port of v4-as-computed-on-a-sigTF
// chart: local trend (v4's timeframe.isdwm branch), all gates on sigTF bars.
sigEngine() =>
    float atrW = ta.atr(atrLen)
    float maW  = trendType == "EMA" ? ta.ema(close, trendLen) : ta.sma(close, trendLen)
    float slopeVal = atrW > 0 ? (maW - maW[slopeLen]) / atrW : 0.0
    bool slopeUp = slopeVal >= slopeMinATR_e
    bool slopeDn = slopeVal <= -slopeMinATR_e
    bool slopeLongOK  = not useSlope or slopeUp
    bool slopeShortOK = not useSlope or slopeDn
    // WHY THIS NESTED CALL CANNOT REPAINT: it requests SPY at the SAME timeframe as the
    // enclosing signal-TF context (v6 dynamic request, both args hard-coded so nothing is
    // inherited). Same-period cross-symbol data has no HTF merge to get wrong, and its
    // values are only ever ACTED on at the signal-TF bar's confirmed close (the chart-level
    // gate), at which moment SPY's same-period bar is also final. lookahead_off everywhere.
    [mktC, mktMA] = request.security(marketSym, sigTF, [close, ta.ema(close, marketMaLen)], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
    bool mktLongOK  = not useMarketFilter or mktC > mktMA
    bool mktShortOK = not useMarketFilter or mktC < mktMA
    // Impulse MACD (identical math to v4)
    float impHi = calc_smma(high, lengthMA)
    float impLo = calc_smma(low, lengthMA)
    float mi = calc_zlema(hlc3, lengthMA)
    float md = mi > impHi ? mi - impHi : mi < impLo ? mi - impLo : 0.0
    float sb = ta.sma(md, lengthSignal)
    bool impBull = not useImpulse or md > sb
    bool impBear = not useImpulse or md < sb
    [macdV, sigV, _h] = ta.macd(close, fastLength, slowLength, signalLength)
    bool macdBullRaw = macdV > sigV
    bool macdBearRaw = macdV < sigV
    bool macdBull = not useMACDGate or macdBullRaw
    bool macdBear = not useMACDGate or macdBearRaw
    float rsiV = ta.rsi(close, rsiLength)
    bool rsiXup = ta.crossover(rsiV, 50.0)
    bool rsiXdn = ta.crossunder(rsiV, 50.0)
    bool rsiLongOK  = not useRSIGate or rsiV > rsiLongLevel_e
    bool rsiShortOK = not useRSIGate or rsiV < rsiShortLevel_e
    [_dp, _dm, adxV] = ta.dmi(adxLen, adxLen)
    bool adxOK = not useADX or adxV >= adxMin_e
    // timeframe.period inside this context IS the signal TF; session tests on weekly bars
    // are undocumented — the input defaults OFF and warns.
    bool inSess = not useSess or not na(time(timeframe.period, sess))
    bool filtersOK = adxOK and inSess
    bool candleBuyOK  = not useCandle or close > open
    bool candleSellOK = not useCandle or close < open
    // Confluence state + edge triggers, detected on SIGNAL-TF bars
    bool longState  = slopeLongOK and macdBull and impBull and rsiLongOK and filtersOK
    bool shortState = slopeShortOK and macdBear and impBear and rsiShortOK and filtersOK
    bool longTrig  = longState and not longState[1]
    bool shortTrig = shortState and not shortState[1]
    float emaF = ta.ema(close, pullbackEMA)
    bool crossUpEma = ta.crossover(close, emaF)
    bool crossDnEma = ta.crossunder(close, emaF)
    bool pullLong  = usePullback and longState and crossUpEma
    bool pullShort = usePullback and shortState and crossDnEma
    // Backtest window, tested on the SIGNAL-TF bar's open time — identical on every chart.
    bool winOpen = time >= startDate and time <= endDate
    // Cooldown in signal-TF bars. v4 reset its cooldown on accepted entry events (doLong);
    // v5 resets on accepted SIGNAL events here, which is identical under default settings
    // (allowReentry on) and keeps the engine position-independent, hence TF-invariant.
    var int lastSigBar = na
    bool cooled = na(lastSigBar) or (bar_index - lastSigBar) >= minBarsBetween
    bool goLraw = allowLongs  and ((useStateEntry and longTrig) or pullLong)  and mktLongOK  and cooled and candleBuyOK  and winOpen
    bool goSraw = allowShorts and ((useStateEntry and shortTrig) or pullShort) and mktShortOK and cooled and candleSellOK and winOpen
    // Conflict rule, faithful to v4 (including v4's quirk that the short side is suppressed
    // on conflict regardless of the toggle — see v4 lines 313-314).
    bool goL = longWinsOnConflict ? goLraw : (goLraw and not goSraw)
    bool goS = goSraw and not goLraw
    if goL or goS
        lastSigBar := bar_index
    // Risk construction on signal-TF values, anchored to this bar's close (as v4)
    float swingLo = ta.lowest(low, structLookback)
    float swingHi = ta.highest(high, structLookback)
    float rawL = close - (swingLo - structBufATR * atrW)
    float riskL = useStructStop and rawL > 0 ? math.max(rawL, atrStopMult * atrW * 0.5) : atrStopMult * atrW
    float rawS = (swingHi + structBufATR * atrW) - close
    float riskS = useStructStop and rawS > 0 ? math.max(rawS, atrStopMult * atrW * 0.5) : atrStopMult * atrW
    // Optional condition exits (validated-off), evaluated on completed signal-TF bars
    bool exCondL = (exitOnMACD and macdBearRaw) or (exitOnTrend and close < maW) or (exitOnRSI and rsiXdn)
    bool exCondS = (exitOnMACD and macdBullRaw) or (exitOnTrend and close > maW) or (exitOnRSI and rsiXup)
    // time / time_close here are the SIGNAL-TF bar's own timestamps — the chart-level gate
    // compares against time_close so both sides of the comparison come from one pipeline.
    [time, time_close, high, low, close, maW, emaF, slopeVal, goL, goS, riskL, riskS, exCondL, exCondS, winOpen]

// ── The ONE evaluation of the engine ───────────────────────────────────────────────────────
// WHY THIS CANNOT REPAINT: (a) lookahead_off — no future signal-TF data is ever imported on
// historical bars (documented; lookahead_on is the only leak vector and is not used anywhere
// in this script). (b) All ACTIONS below are gated on the chart bar whose close time equals
// the signal-TF bar's close time AND barstate.isconfirmed — at that shared instant the
// signal-TF bar is final, so realtime evaluation equals the historical rewrite. Mid-period
// realtime bars do show developing values (inherent to security), but nothing reads them:
// no order, no fingerprint update, no bookkeeping happens off-gate. (c) The engine itself
// uses only completed-bar series arithmetic — no varip, no tick data, no offsets into the
// future.
[wT, wTC, wH, wL, wC, wMA, wEMA, wSlope, wGoL, wGoS, wRiskL, wRiskS, wExL, wExS, wWin] =
     request.security(syminfo.tickerid, sigTF, sigEngine(), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

// ── Signal-TF close detection (the parity gate) — v5.1 ─────────────────────────────────────
// STRICT gate: the chart bar whose close time equals the signal-TF bar's OWN close time
// (wTC, reported by the engine) is the last chart bar of the signal-TF period — the same
// wall-clock instant on 1W, 1D and 5m RTH charts, and the chart's close there IS the
// signal-TF close. No calendar-function assumptions: both timestamps come from the same
// data pipeline. On realtime bars security returns the DEVELOPING signal-TF bar, whose
// close time is already the period's scheduled close — so the strict gate passes only on
// the true last chart bar of the period, at whose confirming update developing == final.
// That is why this cannot repaint AND cannot act early on an incomplete signal-TF bar.
bool tfSupported = timeframe.in_seconds() <= timeframe.in_seconds(sigTF)
// v5.3 — FIRE ONCE PER SIGNAL-TF BAR, ON THE FIRST CHART BAR AT OR AFTER ITS CLOSE.
// v5.1/v5.2 required EXACT timestamp equality (time_close == wTC). That is correct only
// when the chart interval divides the session evenly: a 5m chart's last RTH bar closes at
// 16:00 (390/5 = 78 bars) and matches, but an 8m chart's last bar can close at 16:02
// (390/8 = 48.75) and NEVER matches — the gate silently never fires and the script shows
// no trades at all. The dedup makes ">=" safe: mid-period chart bars still carry the PRIOR
// signal-TF bar's values (already fired, so skipped), and the first bar carrying a NEW
// completed signal-TF bar fires exactly once. On evenly-dividing charts this is bit-for-bit
// the old exact-match behavior, so cross-chart parity is unchanged.
var int lastFiredTC = na
bool wFresh = not na(wTC) and (na(lastFiredTC) or wTC != lastFiredTC)
bool wComplete = tfSupported and wFresh and time_close >= wTC
bool wNew = tfSupported and not na(wT) and wT != nz(wT[1], -1)
// Arrival mode is HISTORICAL-ONLY by design (see the input tooltip).
bool fire = gateMode == "Strict (close-match)" ? wComplete : (wNew and barstate.ishistory)
bool act = fire and barstate.isconfirmed
if act
    lastFiredTC := wTC
// True only when the chart bar's close lands exactly on the signal-TF close — the
// same-instant condition cross-chart PnL parity depends on. Reported in the table.
bool exactAligned = tfSupported and not na(wTC) and time_close == wTC

// ── Self-audits: merge timing + calendar ───────────────────────────────────────────────────
// MERGE LAG: at a signal-TF close, the engine's returned bar (wT) should BE the current
// signal-TF period (documented end-of-period merge for lookahead_off). If TradingView
// delivers it one chart bar later (the folklore "Monday merge"), wT lags time(sigTF) here
// and parity across charts is void — the table reports it instead of lying.
bool mergeLag = act and wT != time(sigTF)
var int lagCount = 0
// GATE HEALTH: fires (our gate) vs signal-TF period starts (timeframe.change, documented
// robust). A dead gate (0 fires while periods elapse) or a drift between the counters is
// printed in the table instead of failing silently.
var int fireCount = 0
var int periodCount = 0
var int offsetFires = 0   // fires that did NOT land exactly on the signal-TF close
if act
    fireCount += 1
    if not exactAligned
        offsetFires += 1
    if mergeLag
        lagCount += 1
if barstate.isconfirmed and timeframe.change(sigTF)
    periodCount += 1
bool calendarWarn = tfSupported and fireCount > 0 and math.abs(fireCount - periodCount) > 1
bool gateDead = tfSupported and periodCount > 2 and fireCount == 0

// ── Window bookkeeping + fingerprint ───────────────────────────────────────────────────────
var int chartStartT = na
if barstate.isfirst
    chartStartT := time
bool windowClipped = chartStartT > startDate
var int firstWinT = na
var int lastWinT  = na
var int fpCount = 0
var int fpHash  = 0
if act and wWin
    if na(firstWinT)
        firstWinT := wT
    lastWinT := wT
if act and (wGoL or wGoS)
    // Fingerprint keys on the SIGNAL-TF bar's open time — identical on every chart — and
    // updates exactly once per signal-TF bar (the gate fires once per period).
    fpCount += 1
    fpHash := (fpHash * FP_MULT + math.round(wT / 1000) % FP_MOD) % FP_MOD

// ── Position bookkeeping & orders (all inside the parity gate) ─────────────────────────────
var float slLong  = na
var float tpLong  = na
var float slShort = na
var float tpShort = na
var float entryPx = na
var int   lastDir = 0
bool isLong  = strategy.position_size > 0
bool isShort = strategy.position_size < 0

bool canL = wGoL and (allowReentry or lastDir != 1)
bool canS = wGoS and (allowReentry or lastDir != -1)
bool doL = longWinsOnConflict ? canL : (canL and not canS)
bool doS = canS and not canL

bool buyEvt  = false
bool sellEvt = false

if act
    // Window force-flatten: the first signal-TF close outside the window closes everything.
    // Anchored to the signal-TF calendar so all charts flatten at the same instant/price.
    if not wWin and (isLong or isShort)
        strategy.close_all(comment="window end")
    // Signal-TF-confirmed bracket: levels tested against the COMPLETED signal-TF bar's
    // range; fill is a market order at this bar's close (process_orders_on_close). The
    // entry bar itself cannot exit (position_size registers on the next evaluation).
    // Deterministic tie rule: if both stop and target were breached inside one signal-TF
    // bar, the STOP wins (conservative; v4 left this to the chart-granularity emulator,
    // which is exactly what broke cross-chart parity).
    if exitOnTarget and isLong and not na(slLong)
        if wL <= slLong
            strategy.close("Long", comment="stopW")
        else if wH >= tpLong
            strategy.close("Long", comment="targetW")
    if exitOnTarget and isShort and not na(slShort)
        if wH >= slShort
            strategy.close("Short", comment="stopW")
        else if wL <= tpShort
            strategy.close("Short", comment="targetW")
    // Optional condition exits (validated-off), skipped when reversing — as v4
    if isLong and wExL and not doS
        strategy.close("Long", comment="exitL")
    if isShort and wExS and not doL
        strategy.close("Short", comment="exitS")
    // Entries. Note the deliberate v4-quirk preservation: a re-signal while already in a
    // position (pyramiding=0 rejects the order) still re-bases stop/target/entryPx to the
    // new signal-TF close and fires the BUY marker/alert with no fill — v4 does exactly
    // this and the Python parity work reproduced it (DAILY_RESET). Remove only with a
    // deliberate re-measure, not as a drive-by cleanup.
    if doL
        strategy.entry("Long", strategy.long, qty=qtyShares)
        buyEvt := true
        lastDir := 1
        slLong := wC - wRiskL
        tpLong := wC + rrRatio * wRiskL
        entryPx := wC
    if doS
        strategy.entry("Short", strategy.short, qty=qtyShares)
        sellEvt := true
        lastDir := -1
        slShort := wC + wRiskS
        tpShort := wC - rrRatio * wRiskS
        entryPx := wC

// ── Chart output ───────────────────────────────────────────────────────────────────────────
bool sUp = wSlope >= slopeMinATR_e
bool sDn = wSlope <= -slopeMinATR_e
bool sFlat = useSlope and not sUp and not sDn
color trendCol = sFlat ? color.new(color.gray, 0) : sUp ? color.new(color.teal, 0) : sDn ? color.new(color.red, 0) : color.new(color.gray, 40)
// Steplines: on a 5m chart these should hold each weekly value flat all week and step once
// at the weekly close — the visual proof the engine is TF-invariant.
plot(showTrend ? wMA : na, "Signal-TF trend line", color=trendCol, linewidth=2, style=plot.style_stepline)
plot(usePullback ? wEMA : na, "Signal-TF fast EMA", color=color.new(color.blue, 55), style=plot.style_stepline)
plot(showRiskLines and isLong ? slLong : showRiskLines and isShort ? slShort : na, "Stop (live)", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)
plot(showRiskLines and isLong ? tpLong : showRiskLines and isShort ? tpShort : na, "Target (live)", color=color.new(color.green, 20), style=plot.style_linebr, linewidth=2)

// Gate-fire shading + data-window diagnostics — table-independent instrumentation.
// Shading only matters when the chart is BELOW the signal TF (on a same-TF chart every
// bar fires and the whole background would tint — observed washing out the 1W pane).
bool shadeRelevant = timeframe.in_seconds() < timeframe.in_seconds(sigTF)
bgcolor(showGateShade and shadeRelevant and act ? color.new(color.aqua, 90) : na, title="Signal-TF close (gate fired)")
plot(fireCount, "DBG gate fires", display=display.data_window)
plot(periodCount, "DBG sigTF periods", display=display.data_window)
plot(fpCount, "DBG fingerprint count", display=display.data_window)
plot(act ? 1 : 0, "DBG act", display=display.data_window)
plot(wComplete ? 1 : 0, "DBG close-match", display=display.data_window)
plot(na(wTC) ? na : (wTC - time_close) / 60000.0, "DBG engine-chart close delta (min)", display=display.data_window)

bool longSold     = strategy.position_size[1] > 0 and strategy.position_size < strategy.position_size[1]
bool shortCovered = strategy.position_size[1] < 0 and strategy.position_size > strategy.position_size[1]
plotshape(showSignals and buyEvt,  "Buy",  shape.labelup,   location.belowbar, buyMarkerCol,  text="BUY",  textcolor=color.white, size=size.normal)
plotshape(showSignals and sellEvt, "Sell (short)", shape.labeldown, location.abovebar, sellMarkerCol, text="SELL", textcolor=color.white, size=size.normal)
plotshape(showSignals and showExits and longSold,     "Sell (exit long)",   shape.labeldown, location.abovebar, sellMarkerCol, text="SELL",  textcolor=color.white,   size=size.normal)
plotshape(showSignals and showExits and shortCovered, "Cover (exit short)", shape.xcross,    location.belowbar, exitMarkerCol, text="COVER", textcolor=exitMarkerCol, size=size.small)

// ── Alerts ─────────────────────────────────────────────────────────────────────────────────
alertcondition(buyEvt,       "Buy",              "[iAPE_v5] BUY {{ticker}} @ {{close}}")
alertcondition(sellEvt,      "Sell (short)",     "[iAPE_v5] SELL (short) {{ticker}} @ {{close}}")
alertcondition(longSold,     "Sell (exit long)", "[iAPE_v5] SELL / EXIT LONG {{ticker}} @ {{close}}")
alertcondition(shortCovered, "Cover short",      "[iAPE_v5] COVER SHORT {{ticker}} @ {{close}}")
alertcondition(buyEvt or sellEvt or longSold or shortCovered, "Any signal", "[iAPE_v5] signal {{ticker}} @ {{close}}")

// ── Connector outputs (hidden) — other scripts can wire these in ───────────────────────────
plot(buyEvt  ? 1 : 0, "→ Buy signal",  color=color.new(color.green, 100), display=display.none)
plot(sellEvt ? 1 : 0, "→ Sell signal", color=color.new(color.red, 100),   display=display.none)
plot(longSold ? 1 : 0, "→ Exit long",  color=color.new(color.orange, 100), display=display.none)
plot(shortCovered ? 1 : 0, "→ Cover short", color=color.new(color.orange, 100), display=display.none)
plot(strategy.position_size > 0 ? 1 : 0, "→ In long position",  color=color.new(color.gray, 100), display=display.none)
plot(strategy.position_size < 0 ? 1 : 0, "→ In short position", color=color.new(color.gray, 100), display=display.none)

// ── Market regime read-out (display only, unchanged from v4) ───────────────────────────────
// WHY THIS CANNOT SHOW UNCONFIRMED DATA: every term is offset >=1 completed DAILY bar
// ([1]/[6]), lookahead_off. It gates nothing (display-only) and its constants are FROZEN
// for byte-parity with switch_shadow.py — deliberately not inputs. On intraday charts the
// realtime label can be one daily bar fresher than its historical rewrite (documented
// lookahead_off phase behavior); harmless for a label that changes nothing.
regimeUp = request.security(marketSym, "D",
     close[1] > ta.sma(close, 50)[1] and ta.sma(close, 50)[1] > ta.sma(close, 50)[6],
     lookahead=barmerge.lookahead_off)

// ── Fallback HUD label — a LABEL on purpose, not a table ───────────────────────────────────
// Observed 2026-07-31: tables rendered on the 5m pane but not on the 1W/1D panes of the
// same layout. Labels use a different render path, so the core numbers ride here too.
var label hud = na
if barstate.islast and showHud
    label.delete(hud)
    string hudTxt = "iAPE v5 · gate " + str.tostring(fireCount) + "/" + str.tostring(periodCount) +
         " · fp " + str.tostring(fpCount) + "·h" + str.tostring(fpHash) +
         " · trades " + str.tostring(strategy.closedtrades) +
         (windowClipped ? " · CLIPPED" : "") + (gateDead ? " · GATE DEAD" : "") +
         (lagCount > 0 ? " · LAG " + str.tostring(lagCount) : "")
    hud := label.new(bar_index, high, hudTxt, style=label.style_label_lower_left,
         color=color.new(color.black, 20), textcolor=color.white, size=size.normal)

// ── Parity diagnostics table (top right) — THE acceptance test ─────────────────────────────
// 20 rows: 10 fixed + up to 6 conditional warnings, with headroom. (v5.2 sized this at 14,
// which a full warning stack could overflow — and an out-of-range table.cell is a RUNTIME
// ERROR that kills every remaining drawing on the pane, table and label alike.)
var table pt = table.new(position.top_right, 2, 20, frame_width=1,
     frame_color=color.new(color.gray, 40), border_width=1, border_color=color.new(color.gray, 80))
p_row(int r, string k, string v, color vcol) =>
    table.cell(pt, 0, r, k, text_color=color.new(color.white, 15), text_halign=text.align_right, bgcolor=color.new(color.black, 20), text_size=dashSize)
    table.cell(pt, 1, r, v, text_color=vcol, text_halign=text.align_left, bgcolor=color.new(color.black, 35), text_size=dashSize)

if barstate.islast and showParity
    grey  = color.new(color.white, 35)
    green = color.new(#26a69a, 0)
    red   = color.new(#ef5350, 0)
    amber = color.new(color.orange, 0)
    table.cell(pt, 0, 0, "iAPE v5 · parity", text_color=color.white, bgcolor=color.new(color.teal, 15), text_size=dashSize)
    table.cell(pt, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.new(color.teal, 15), text_size=dashSize)
    p_row(1, "Chart TF", timeframe.period, grey)
    p_row(2, "Signal TF", sigTF, grey)
    p_row(3, "Window start", na(firstWinT) ? "—" : str.format_time(firstWinT, "yyyy-MM-dd", "America/New_York"), grey)
    p_row(4, "Window end", na(lastWinT) ? "—" : str.format_time(lastWinT, "yyyy-MM-dd", "America/New_York"), grey)
    p_row(5, "Closed trades", str.tostring(strategy.closedtrades), grey)
    p_row(6, "Net profit", (strategy.netprofit >= 0 ? "+" : "") + str.tostring(strategy.netprofit, "#,###.##"), strategy.netprofit >= 0 ? green : red)
    p_row(7, "Fingerprint", str.tostring(fpCount) + " · h=" + str.tostring(fpHash), color.new(color.aqua, 0))
    p_row(8, "Gate fires", str.tostring(fireCount) + "/" + str.tostring(periodCount), fireCount > 0 ? grey : amber)
    p_row(9, "Timing", str.format_time(time_close, "MM-dd HH:mm", "America/New_York") + " vs " + (na(wTC) ? "na" : str.format_time(wTC, "MM-dd HH:mm", "America/New_York")), grey)
    int r = 10
    if not tfSupported
        p_row(r, "✖ ERROR", "chart TF > signal TF", red)
        r += 1
    if gateDead
        p_row(r, "✖ GATE DEAD", "0/" + str.tostring(periodCount) + " — try Arrival mode", red)
        r += 1
    if windowClipped
        p_row(r, "⚠ CLIPPED", "history " + str.format_time(chartStartT, "yyyy-MM-dd", "America/New_York"), amber)
        r += 1
    if lagCount > 0
        p_row(r, "⚠ MERGE LAG", "n=" + str.tostring(lagCount), amber)
        r += 1
    if calendarWarn
        p_row(r, "⚠ CALENDAR", str.tostring(fireCount) + " vs " + str.tostring(periodCount), amber)
        r += 1
    if offsetFires > 0
        p_row(r, "⚠ OFF-GRID TF", str.tostring(offsetFires) + " fires landed after (not on) the signal-TF close — this chart interval doesn't divide the session evenly. Signals are correct; exact PnL parity with an aligned chart is not.", amber)
        r += 1
    if tfSupported and not windowClipped and lagCount == 0 and not calendarWarn and not gateDead and offsetFires == 0
        p_row(r, "Status", "OK — compare fp/trades/net", green)

// ── Plain-English dashboard (bottom, compact) ──────────────────────────────────────────────
var table dash = table.new(position.bottom_center, 2, 8, frame_width=1,
     frame_color=color.new(color.gray, 40), border_width=1, border_color=color.new(color.gray, 80))
f_row(int r, string k, string v, color vcol) =>
    table.cell(dash, 0, r, k, text_color=color.new(color.white, 15), text_halign=text.align_right, bgcolor=color.new(color.black, 20), text_size=dashSize)
    table.cell(dash, 1, r, v, text_color=vcol, text_halign=text.align_left, bgcolor=color.new(color.black, 35), text_size=dashSize)

if barstate.islast and showDash
    grey  = color.new(color.white, 35)
    green = color.new(#26a69a, 0)
    red   = color.new(#ef5350, 0)
    string modeTag = isStrict ? "STRICT (unvalidated)" : "v5 weekly engine"
    table.cell(dash, 0, 0, "iAPE v5 · " + modeTag, text_color=color.white, bgcolor=color.new(isStrict ? color.orange : color.teal, 15), text_size=dashSize)
    table.cell(dash, 1, 0, syminfo.ticker + "  ·  signals on " + sigTF, text_color=color.white, bgcolor=color.new(isStrict ? color.orange : color.teal, 15), text_size=dashSize)
    string posTxt = "FLAT — waiting for a signal-TF setup"
    color posCol = grey
    if isLong
        posTxt := "LONG " + str.tostring(math.abs(strategy.position_size), "#.##") + " shares @ " + str.tostring(strategy.position_avg_price, format.mintick)
        posCol := green
    if isShort
        posTxt := "SHORT " + str.tostring(math.abs(strategy.position_size), "#.##") + " shares @ " + str.tostring(strategy.position_avg_price, format.mintick)
        posCol := red
    f_row(1, "Right now", posTxt, posCol)
    string riskTxt = "—"
    if isLong
        riskTxt := "stop " + str.tostring(slLong, format.mintick) + "  →  target " + str.tostring(tpLong, format.mintick) + "  (tested at signal-TF closes)"
    if isShort
        riskTxt := "stop " + str.tostring(slShort, format.mintick) + "  →  target " + str.tostring(tpShort, format.mintick) + "  (tested at signal-TF closes)"
    f_row(2, "The plan", riskTxt, grey)
    tot = strategy.closedtrades
    wr  = tot > 0 ? 100.0 * strategy.wintrades / tot : na
    f_row(3, "Trades on this chart", str.tostring(tot) + (tot > 0 ? "  (won " + str.tostring(wr, "#.#") + "% of them)" : ""), grey)
    gp = strategy.grossprofit
    gl = strategy.grossloss
    pf = gl > 0 ? gp / gl : na
    f_row(4, "Profit factor", na(pf) ? "—" : "made $" + str.tostring(pf, "#.##") + " for every $1 lost", na(pf) ? grey : pf >= 1.1 ? green : pf >= 0.95 ? grey : red)
    np = strategy.netprofit
    f_row(5, "Net result", (np >= 0 ? "+" : "") + str.tostring(np, "#,###") + " USD", np > 0 ? green : np < 0 ? red : grey)
    f_row(6, "This engine", "UNVALIDATED — new fill semantics; v4 evidence void", color.new(color.orange, 0))
    if showRegime
        string regTxt = regimeUp ? "MOMENTUM weather (label only)" : "MEAN-REVERSION weather (label only)"
        f_row(7, "Market regime", regTxt, grey)
