// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// ═══ iAPE X-RAY (formerly SWING_PRO X-RAY) — see WHY the strategy does (and doesn't) fire ═══════════════════
// Companion pane for iAPE v4 (engine v2.2) (same math, same non-repainting HTF logic).
// The strategy only shows trades it TOOK. New ideas live in the trades it ALMOST took.
//
//   • 7 heat-rows, one per long-side gate: green = passing, red = blocking.
//   • Confluence score column (0-7) behind them.
//   • ◆ NEAR-MISS marker when exactly 6 of 7 gates pass — study these bars: what
//     was the one blocker, and would the trade have worked? That's your idea mine.
//   • Live table: each gate's current state + value, so "why no trade right now"
//     has an instant answer.
//
// HOW TO USE FOR IDEAS: scroll history, find ◆ clusters. If one gate blocks many
// would-be winners, that's a candidate to re-test. If near-misses mostly fail,
// the gates are earning their keep. (Then validate in the Python harness before
// believing anything — chart eyes curve-fit faster than any optimizer.)
// Not financial advice.
//@version=6
indicator("iAPE X-RAY", shorttitle="iAPE_XRAY", overlay=false, max_labels_count=500)

// ── Inputs (mirror v2.2 defaults — keep in sync with the strategy) ─────────────────────
useAutoHTF   = input.bool(true, "Auto higher timeframe (×15)", group="Trend regime")
autoHtfMult  = input.int(15, "HTF multiplier", minval=2, maxval=60, group="Trend regime")
htfTfManual  = input.timeframe("60", "Manual HTF (if auto off)", group="Trend regime")
trendLen     = input.int(50, "Trend length", minval=10, maxval=200, group="Trend regime")
slopeLen     = input.int(3, "Slope lookback (HTF bars)", minval=1, group="Trend regime")
slopeMinATR  = input.float(0.20, "Min slope (ATR units)", step=0.05, group="Trend regime")
fastLength   = input.int(12, "MACD fast", group="Momentum")
slowLength   = input.int(26, "MACD slow", group="Momentum")
signalLength = input.int(9, "MACD signal", group="Momentum")
lengthMA     = input.int(34, "Impulse length", group="Momentum")
lengthSignal = input.int(9, "Impulse signal", group="Momentum")
rsiLength    = input.int(14, "RSI length", group="Momentum")
rsiLongLevel = input.int(52, "RSI long level", group="Momentum")
adxLen       = input.int(14, "ADX length", group="Filters")
adxMin       = input.int(20, "ADX minimum", group="Filters")
marketSym    = input.symbol("SPY", "Market index", group="Filters")
marketMaLen  = input.int(50, "Market MA length", group="Filters")
atrLen       = input.int(14, "ATR length", group="Filters")
showTable    = input.bool(true, "Show live gate table", group="Display")

// ── Same math as the strategy ───────────────────────────────────────────────────────────
calc_smma(src, len) =>
    var float s = na
    s := na(s[1]) ? ta.sma(src, len) : (s[1] * (len - 1) + src) / len
    s
calc_zlema(src, length) =>
    e1 = ta.ema(src, length)
    e2 = ta.ema(e1, length)
    e1 + (e1 - e2)

atr = ta.atr(atrLen)
chartSec = timeframe.in_seconds(timeframe.period)
autoSec  = chartSec * autoHtfMult
htfAuto  = autoSec % 60 == 0 ? str.tostring(int(autoSec / 60)) : str.tostring(int(autoSec)) + "S"
// daily+ charts: the validated iAPE-D config uses the LOCAL daily trend
useHTF_x = not timeframe.isdwm
htfTf    = timeframe.isdwm ? "W" : (useAutoHTF ? htfAuto : htfTfManual)
localMA  = ta.ema(close, trendLen)
atrLoc   = ta.atr(atrLen)
[htfMA, htfMAprev, htfATR] = request.security(syminfo.tickerid, htfTf, [localMA[1], localMA[1 + slopeLen], ta.atr(atrLen)[1]], lookahead=barmerge.lookahead_off)
slopeATRval = useHTF_x ? (htfATR > 0 ? (htfMA - htfMAprev) / htfATR : 0.0) : (atrLoc > 0 ? (localMA - localMA[slopeLen]) / atrLoc : 0.0)

[mktClose, mktMA] = request.security(marketSym, timeframe.period, [close, ta.ema(close, marketMaLen)])

srcImp = hlc3
impHi = calc_smma(high, lengthMA)
impLo = calc_smma(low,  lengthMA)
mi    = calc_zlema(srcImp, lengthMA)
md    = mi > impHi ? mi - impHi : mi < impLo ? mi - impLo : 0.0
sb    = ta.sma(md, lengthSignal)
[macdValue, signalValue, _h] = ta.macd(close, fastLength, slowLength, signalLength)
rsiValue = ta.rsi(close, rsiLength)
[dip, dim, adxValue] = ta.dmi(adxLen, adxLen)

// ── The 7 long-side gates ────────────────────────────────────────────────────────────────
g1 = slopeATRval >= slopeMinATR        // HTF slope up
g2 = macdValue > signalValue           // MACD
g3 = md > sb                           // Impulse
g4 = rsiValue > rsiLongLevel           // RSI pressure
g5 = adxValue >= adxMin                // ADX strength
g6 = mktClose > mktMA                  // Market aligned
g7 = close > open                      // Green entry bar

score = (g1 ? 1 : 0) + (g2 ? 1 : 0) + (g3 ? 1 : 0) + (g4 ? 1 : 0) + (g5 ? 1 : 0) + (g6 ? 1 : 0) + (g7 ? 1 : 0)
allOn    = score == 7
nearMiss = score == 6

// ── Paint ────────────────────────────────────────────────────────────────────────────────
cOn  = color.new(#26a69a, 15)
cOff = color.new(#e53935, 70)
plot(7, "Slope",   color=g1 ? cOn : cOff, linewidth=5, style=plot.style_linebr)
plot(6, "MACD",    color=g2 ? cOn : cOff, linewidth=5, style=plot.style_linebr)
plot(5, "Impulse", color=g3 ? cOn : cOff, linewidth=5, style=plot.style_linebr)
plot(4, "RSI",     color=g4 ? cOn : cOff, linewidth=5, style=plot.style_linebr)
plot(3, "ADX",     color=g5 ? cOn : cOff, linewidth=5, style=plot.style_linebr)
plot(2, "Market",  color=g6 ? cOn : cOff, linewidth=5, style=plot.style_linebr)
plot(1, "Candle",  color=g7 ? cOn : cOff, linewidth=5, style=plot.style_linebr)
plot(score * 7.0 / 7.0 * 0 - 1, display=display.none)  // reserve space below rows
plotshape(nearMiss and barstate.isconfirmed ? 0 : na, "Near miss (6/7)", shape.diamond, location.absolute, color.new(color.orange, 0), size=size.tiny)
plotshape(allOn and not allOn[1] and barstate.isconfirmed ? 0 : na, "All 7 align", shape.triangleup, location.absolute, color.new(#26a69a, 0), size=size.small)
bgcolor(allOn ? color.new(#26a69a, 88) : na)

// ── Live gate table ──────────────────────────────────────────────────────────────────────
var table tb = table.new(position.top_right, 3, 8, frame_width=1, frame_color=color.new(color.gray, 50))
cell(int r, string a, string b, bool ok) =>
    table.cell(tb, 0, r, a, text_color=color.new(color.white, 20), text_halign=text.align_right, text_size=size.small, bgcolor=color.new(color.black, 30))
    table.cell(tb, 1, r, b, text_color=color.new(color.white, 30), text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(tb, 2, r, ok ? "PASS" : "block", text_color=ok ? color.new(#26a69a, 0) : color.new(#e53935, 0), text_size=size.small, bgcolor=color.new(color.black, 40))

if barstate.islast and showTable
    table.cell(tb, 0, 0, "X-RAY", text_color=color.white, bgcolor=color.new(color.teal, 20), text_size=size.small)
    table.cell(tb, 1, 0, str.tostring(score) + "/7", text_color=color.white, bgcolor=color.new(color.teal, 20), text_size=size.small)
    table.cell(tb, 2, 0, allOn ? "ARMED" : nearMiss ? "near miss" : "off", text_color=color.white, bgcolor=color.new(color.teal, 20), text_size=size.small)
    cell(1, "HTF slope", str.tostring(slopeATRval, "#.##") + " ATR (need " + str.tostring(slopeMinATR) + ")", g1)
    cell(2, "MACD", str.tostring(macdValue - signalValue, "#.###"), g2)
    cell(3, "Impulse", str.tostring(md - sb, "#.###"), g3)
    cell(4, "RSI", str.tostring(rsiValue, "#.#") + " (need >" + str.tostring(rsiLongLevel) + ")", g4)
    cell(5, "ADX", str.tostring(adxValue, "#.#") + " (need ≥" + str.tostring(adxMin) + ")", g5)
    cell(6, "SPY trend", mktClose > mktMA ? "above MA" : "below MA", g6)
    cell(7, "Entry bar", g7 ? "green" : "red", g7)

// ── Alerts + connector outputs ───────────────────────────────────────────────────────────
alertcondition(allOn and not allOn[1], "All 7 gates align", "[XRAY] {{ticker}} 7/7 armed @ {{close}}")
alertcondition(nearMiss and not nearMiss[1], "Near miss (6/7)", "[XRAY] {{ticker}} 6/7 @ {{close}}")
plot(score, "→ Confluence score", color=color.new(color.teal, 100), display=display.none)
plot(allOn ? 1 : 0, "→ Armed", color=color.new(color.green, 100), display=display.none)
