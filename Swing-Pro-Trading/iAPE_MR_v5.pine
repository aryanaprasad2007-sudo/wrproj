// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// ═══ iAPE MR v5 — Mean-Reversion on the v5 signal-TF architecture ══════════════════════════
//
// WHAT THIS IS: the validated MR-1 mean-reversion engine (iAPE_MR.pine), re-plumbed onto the
// iAPE v5 architecture: all signal computation anchored to one configurable signal timeframe
// (default D — MR-1 was validated on DAILY bars), evaluated once via request.security, acting
// only on confirmed signal-TF bars through the v5.1 close-match gate, with the v5.2
// diagnostics (parity table, HUD label, gate shading, data-window debug values).
//
// THE LOGIC (unchanged from the validated engine — buy oversold dips inside an uptrend):
//   ENTRY — close ABOVE its 200-bar average (dip-buy only in uptrends) AND RSI(3) < 15
//           (sharp washout). Long only. Enter at the NEXT bar's open.
//   EXIT  — first close back ABOVE the 10-bar average (snapback = profit, bank it), or
//           10 signal-TF bars elapsed (time stop), or price 3×ATR below entry (disaster
//           stop, resting order, rarely fires). No profit target — MR's edge is a high
//           hit-rate (~64%) on small fast moves, the mirror image of momentum.
//
// FILL SEMANTICS — DELIBERATELY NOT the momentum-v5 close-fill design: MR-1's validation
// (mean_rev.py, 3 decades, 2,809 trades) uses signal-on-close → fill-at-NEXT-OPEN, and the
// live shadow audition runs the same way. This script keeps that (no process_orders_on_close).
// Consequence: run it with CHART TF == SIGNAL TF (a daily chart). On a lower-TF chart the
// "next bar" is minutes away instead of next session's open, which changes fills away from
// the validated semantics — the table warns if you do that.
//
// ⚠ HONESTY BLOCK — read before trading this chart:
//   • The validated edge is a PORTFOLIO (max 10 concurrent, most-oversold-first across 22
//     names, PF 1.21-1.36 by decade). One chart cannot see the other symbols or enforce the
//     cap, so a single-symbol backtest runs RICHER than the validated truth.
//   • MR dies on strong momentum names: NVDA and AAPL were NEGATIVE in the 30y baseline,
//     and PRI measured NEGATIVE on this engine (2026-07-30, MAR −0.029). Do not point this
//     at momentum leaders and expect the portfolio PF. Judge per symbol, ≥30 trades.
//   • Combining this with the momentum engine on ONE symbol was measured and LOST
//     (−30.7% MAR vs momentum alone on PRI) — the regime switch only pays at portfolio
//     level. The weekly iAPE chart beside this one is a WEATHER READ, not a gate.
// Not financial advice.
//@version=6
// pyramiding=4 enables the optional dip-STACKING lever (group 1). It changes nothing unless
// stacking is switched on: every preset except "Maximum" gates entries on being flat, so the
// validated path issues exactly one unit and behaves identically to pyramiding=0.
strategy("iAPE MR v5 — Mean-Reversion (signal-TF engine)", shorttitle="iAPE_MR_v5", overlay=true,
     max_labels_count=500, pyramiding=4, calc_on_every_tick=false,
     initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.01, slippage=1,
     use_bar_magnifier=false, dynamic_requests=true)
// initial_capital cannot be a Pine input — override in Properties. Fixed-share sizing (input
// below) replaces the old 10%-of-equity: deterministic and comparable across settings.

// ── Signal engine timeframe & gate ─────────────────────────────────────────────────────────
gSE = "Signal Engine"
sigTF = input.timeframe("D", "Signal timeframe", group=gSE, tooltip="MR-1 was validated on DAILY bars — leave this at D unless you are deliberately re-testing. All entries/exits decide on completed bars of this timeframe regardless of the chart. Run the chart AT this timeframe for validated fill semantics.")
gateMode = input.string("Strict (close-match)", "Action gate", options=["Strict (close-match)", "Arrival (diagnostic)"], group=gSE, tooltip="Strict (default): act only on the chart bar whose close time equals the signal-TF bar's own close time — live-safe. Arrival (diagnostic): act on the historical bar where a new completed signal-TF evaluation first appears; historical bars only, never acts live. Use only if the table shows GATE DEAD.")

// ── 1) Entry ───────────────────────────────────────────────────────────────────────────────
g1 = "1) Entry — buy the oversold dip inside an uptrend"
// SIGNAL FREQUENCY DIAL. Trade COUNT on this engine is governed by three things, in order of
// leverage: (1) how oversold counts as oversold (rsiEntry), (2) how long capital stays tied
// up (timeStop — the engine is flat-only, so a held position BLOCKS every new signal), and
// (3) how strict the uptrend filter is (trendLen). The presets move all three together.
// ⚠ Only "Validated" is the tested configuration. The others trade MORE and, on every
// measurement we have, trade WORSE per trade — RSI<15 is deep-washout mean reversion; at
// RSI<35 you are buying ordinary weakness, which is a different (and unvalidated) bet.
sigFreq = input.string("Validated (as tested)", "Signal frequency", options=["Validated (as tested)", "More signals (looser)", "Most signals (loosest)", "Maximum signals (barely filtered)", "Custom (use the raw inputs)"], group=g1, tooltip="Each step down trades more and filters less. Only the first is the tested engine.\n\nVALIDATED — RSI(3)<15, 200-bar uptrend filter, 10-bar time stop, one position at a time. The configuration behind PF 1.21-1.36 across three decades.\n\nMORE — RSI(3)<25, 200-bar filter, 7-bar stop. Roughly 3-5x the entries.\n\nMOST — RSI(2)<35, 100-bar filter, 5-bar stop. RSI(2) swings harder than RSI(3), so it reaches any threshold more often.\n\nMAXIMUM — RSI(2)<45, NO uptrend filter, 3-bar stop, and dip-STACKING (up to 4 concurrent adds). This buys ordinary weakness in ANY trend, including downtrends, and is the loosest the engine can go without becoming a different strategy. It is closer to 'buy every red patch' than to mean reversion.\n\nCUSTOM — the raw inputs below.\n\nEverything past Validated is UNVALIDATED and trades worse per trade. The dashboard prints which tier is live so a loose backtest can never be quoted later as the real one.")
rsiLen   = input.int(3, "RSI length (short & sharp)", minval=1, group=g1, tooltip="RSI(3) is a fast washout gauge, not the usual RSI(14). LOWER = more volatile = reaches oversold MORE often (RSI(2) is the biggest single frequency lever after the threshold itself). Computed on signal-TF closes. ONLY USED when Signal frequency is Custom.")
stackDips = input.bool(false, "Allow stacking (add on further dips, up to 4)", group=g1, tooltip="Off (validated): one position at a time — while you hold, every new signal is skipped, which is the single biggest brake on trade count. On: each fresh signal adds another unit up to 4. Raises exposure as well as trade count; the whole stack exits together. ONLY USED when Signal frequency is Custom (the Maximum preset forces it on).")
rsiEntry = input.float(15.0, "Buy when RSI is below", minval=1, maxval=50, step=1, group=g1, tooltip="Deep oversold. 15 is the validated level; higher = more (shallower) entries. ONLY USED when Signal frequency is set to Custom.")
trendLen = input.int(200, "Only in uptrends: price above this average", minval=20, maxval=400, step=10, group=g1, tooltip="The regime filter, in signal-TF bars. Dip-buying only works while the longer trend is up — below the 200-bar average a dip is often just the start of a decline. ONLY USED when Signal frequency is set to Custom.")

// ── 2) Exit ────────────────────────────────────────────────────────────────────────────────
g2 = "2) Exit — the bounce is the profit, don't overstay"
exitMaLen = input.int(10, "Exit on first close above this average", minval=2, maxval=50, step=1, group=g2, tooltip="The mean it's reverting to, in signal-TF bars. First close back above it = the snapback happened, bank it (fills next bar's open).")
timeStop  = input.int(10, "Give up after this many signal-TF bars", minval=1, maxval=40, group=g2, tooltip="If the bounce hasn't come by now, the setup failed — free the capital. Counted in signal-TF bars, so it is chart-independent. Because the engine is FLAT-ONLY, this is also a signal-count lever: every bar you stay in a trade is a bar you cannot take a new one. ONLY USED when Signal frequency is set to Custom.")
atrLen    = input.int(14, "Volatility lookback for the disaster stop", minval=1, group=g2, tooltip="ATR length in signal-TF bars.")
stopMult  = input.float(3.0, "Disaster stop distance (×ATR — wide, rarely fires)", minval=0.5, maxval=8.0, step=0.5, group=g2, tooltip="A safety net, NOT trade management: it only saves you if a dip becomes a crash. Held as a RESTING stop order (fills intrabar at chart granularity — the one v4-style order kept, because the validated engine has it too).")

// ── 3) Backtest window ─────────────────────────────────────────────────────────────────────
gW = "Window"
startDate = input.time(timestamp("01 Apr 2010 00:00 -0500"), "Backtest start", group=gW, tooltip="Tested against the SIGNAL-TF bar's open time so the same bars are in-window on every chart. Default = PRI's IPO for layout consistency with iAPE v5; adjust per symbol.")
endDate   = input.time(timestamp("01 Jan 2100 00:00 -0500"), "Backtest end", group=gW, tooltip="Entries stop and any open position is force-flattened at the first signal-TF close outside the window.")

// ── 4) Sizing ──────────────────────────────────────────────────────────────────────────────
gQ = "Sizing"
qtyShares = input.int(100, "Shares per trade (fixed)", minval=1, group=gQ, tooltip="Fixed share count for every entry. Percent-of-equity compounds differently at different trade counts and muddies comparisons — deliberately not offered.")

// ── 5) Display ─────────────────────────────────────────────────────────────────────────────
g3 = "5) Display & diagnostics"
showParity  = input.bool(true, "Show diagnostics table (top right)", group=g3, tooltip="Window / trades / net / fingerprint / gate health. Compare across charts if you run this on more than one.")
showDash    = input.bool(true, "Show plain-English dashboard (bottom)", group=g3, tooltip="Position, setup state and honesty rows.")
showHud     = input.bool(true, "Show fallback HUD label (diagnostics)", group=g3, tooltip="One-line label next to the last bar with the core numbers. A LABEL, not a table — renders even when tables don't.")
showGateShade = input.bool(true, "Shade gate-fire bars (chart below signal TF only)", group=g3, tooltip="Faint stripe on chart bars where the signal-TF close gate fired. Auto-off when chart TF equals the signal TF (every bar would tint).")
showSignals = input.bool(true, "Show BUY / EXIT markers", group=g3, tooltip="Entry and exit markers via plotshape.")
showLevels  = input.bool(true, "Draw the trend, exit-mean & stop lines", group=g3, tooltip="Signal-TF values drawn as steplines so you can verify they hold flat between signal-TF closes.")
showRegime  = input.bool(true, "Show market regime (label only — changes nothing)", group=g3, tooltip="The frozen switch-policy classifier (SPY above a rising 50-day SMA, prior daily close). READ-OUT ONLY — combining the engines on one symbol was measured and LOST (2026-07-30).")
buyCol  = input.color(#26a69a, "Buy colour", group=g3, tooltip="Marker colour for entries.")
exitCol = input.color(#f2a900, "Exit colour", group=g3, tooltip="Marker colour for exits.")
dashSizeStr = input.string("Normal", "Table text size", options=["Small", "Normal", "Large"], group=g3, tooltip="Applies to both tables.")
dashSize = dashSizeStr == "Small" ? size.small : dashSizeStr == "Large" ? size.large : size.normal

// ── Fingerprint constants (named, not magic) ───────────────────────────────────────────────
int FP_MOD  = 1000000007  // prime modulus keeps the running hash inside exact-int range
int FP_MULT = 31          // polynomial-rolling-hash multiplier

// ── Frequency-preset effective values ──────────────────────────────────────────────────────
// Named constants, not inline magic numbers. Validated row = the tested configuration.
// Four levers move together, in descending order of how much each raises trade count:
//   rsiEntry (threshold) > stacking (removes the flat-only brake) > rsiLen (RSI(2) swings
//   wider than RSI(3), so it crosses any level more often) > timeStop (frees capital sooner)
//   > trend filter (off = dip-buy in downtrends too).
float RSI_VALID = 15.0, RSI_LOOSE = 25.0, RSI_LOOSEST = 35.0, RSI_MAX = 45.0
int   RSILEN_VALID = 3, RSILEN_LOOSE = 2
int   TREND_VALID = 200, TREND_LOOSEST = 100
int   TSTOP_VALID = 10, TSTOP_LOOSE = 7, TSTOP_LOOSEST = 5, TSTOP_MAX = 3
bool isValidCfg  = sigFreq == "Validated (as tested)"
bool isMoreCfg   = sigFreq == "More signals (looser)"
bool isLoosest   = sigFreq == "Most signals (loosest)"
bool isMaxCfg    = sigFreq == "Maximum signals (barely filtered)"
bool isCustomCfg = sigFreq == "Custom (use the raw inputs)"
float rsiEntry_e = isCustomCfg ? rsiEntry : isValidCfg ? RSI_VALID : isMoreCfg ? RSI_LOOSE : isLoosest ? RSI_LOOSEST : RSI_MAX
int   rsiLen_e   = isCustomCfg ? rsiLen : (isValidCfg or isMoreCfg) ? RSILEN_VALID : RSILEN_LOOSE
int   trendLen_e = isCustomCfg ? trendLen : isLoosest ? TREND_LOOSEST : TREND_VALID
int   timeStop_e = isCustomCfg ? timeStop : isValidCfg ? TSTOP_VALID : isMoreCfg ? TSTOP_LOOSE : isLoosest ? TSTOP_LOOSEST : TSTOP_MAX
bool  useTrend_e = isCustomCfg ? true : not isMaxCfg   // Maximum drops the uptrend filter
bool  stack_e    = isCustomCfg ? stackDips : isMaxCfg  // Maximum forces dip-stacking on

// ── THE SIGNAL ENGINE — every series in here is a SIGNAL-TF series ─────────────────────────
// Evaluated only inside request.security(sigTF): close/time/etc. are signal-TF values.
// Position-independent on purpose — flat-only entry and the time stop are chart-level
// bookkeeping, so the fingerprint (raw signals) stays identical on every chart.
mrEngine() =>
    float trendMA = ta.sma(close, trendLen_e)
    float exitMA  = ta.sma(close, exitMaLen)
    float rsiV    = ta.rsi(close, rsiLen_e)
    float atrW    = ta.atr(atrLen)
    bool regimeOK = not useTrend_e or (not na(trendMA) and close > trendMA)
    bool washout  = not na(rsiV) and rsiV < rsiEntry_e
    bool winOpen  = time >= startDate and time <= endDate
    bool goRaw    = regimeOK and washout and winOpen
    bool meanBack = not na(exitMA) and close > exitMA
    [time, time_close, close, trendMA, exitMA, rsiV, atrW, regimeOK, goRaw, meanBack, winOpen]

// ── The ONE evaluation of the engine ───────────────────────────────────────────────────────
// WHY THIS CANNOT REPAINT: lookahead_off — no future signal-TF data is ever imported on
// historical bars, and nothing below acts outside the close-match gate + barstate.isconfirmed,
// at which shared instant the signal-TF bar's developing values ARE its final values. The
// engine uses only completed-bar arithmetic — no varip, no ticks, no future offsets.
[wT, wTC, wC, wTrend, wExit, wRsi, wAtr, wRegime, wGo, wMean, wWin] =
     request.security(syminfo.tickerid, sigTF, mrEngine(), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

// ── Signal-TF close detection (v5.1 gate) + health counters ────────────────────────────────
bool tfSupported = timeframe.in_seconds() <= timeframe.in_seconds(sigTF)
// v5.3 — FIRE ONCE PER SIGNAL-TF BAR, ON THE FIRST CHART BAR AT OR AFTER ITS CLOSE.
// Exact timestamp equality only works when the chart interval divides the session evenly:
// a 5m chart's last RTH bar closes at 16:00 (390/5 = 78) and matches the daily close, but
// an 8m chart's last bar can close at 16:02 (390/8 = 48.75) and NEVER matches — the gate
// never fires and the script shows nothing. The dedup makes ">=" safe: mid-period bars
// carry the already-fired prior signal-TF bar, so only a NEW completed one fires, once.
var int lastFiredTC = na
bool wFresh = not na(wTC) and (na(lastFiredTC) or wTC != lastFiredTC)
bool wComplete = tfSupported and wFresh and time_close >= wTC
bool wNew = tfSupported and not na(wT) and wT != nz(wT[1], -1)
bool fire = gateMode == "Strict (close-match)" ? wComplete : (wNew and barstate.ishistory)
bool act = fire and barstate.isconfirmed
if act
    lastFiredTC := wTC
bool exactAligned = tfSupported and not na(wTC) and time_close == wTC

// Scoped to charts BELOW the signal TF: on a same-TF chart no merge happens, and this
// chart-side calendar comparison could only produce false alarms (review 2026-07-31).
bool fillsOffSpec0 = timeframe.in_seconds() < timeframe.in_seconds(sigTF)
bool mergeLag = act and fillsOffSpec0 and wT != time(sigTF)
var int lagCount = 0
var int fireCount = 0
var int periodCount = 0
var int offsetFires = 0   // fires that did NOT land exactly on the signal-TF close
var int armedCount = 0    // signal-TF bars where the uptrend filter passed (entry was possible)
var float lastRsi = na    // most recent signal-TF RSI seen at a gate fire
var float minRsi = na     // lowest signal-TF RSI seen in the whole loaded window
if act
    fireCount += 1
    if not exactAligned
        offsetFires += 1
    if mergeLag
        lagCount += 1
    if wRegime
        armedCount += 1
    lastRsi := wRsi
    minRsi := na(minRsi) ? wRsi : math.min(minRsi, wRsi)
if barstate.isconfirmed and timeframe.change(sigTF)
    periodCount += 1
bool calendarWarn = tfSupported and fireCount > 0 and math.abs(fireCount - periodCount) > 1
bool gateDead = tfSupported and periodCount > 2 and fireCount == 0
// Fill-semantics warning: below the signal TF, "next bar's open" is minutes away, not the
// next session — fills leave the validated convention.
bool fillsOffSpec = tfSupported and timeframe.in_seconds() < timeframe.in_seconds(sigTF)

// ── Window bookkeeping + fingerprint (raw engine signals, position-independent) ────────────
var int chartStartT = na
if barstate.isfirst
    chartStartT := time
// One signal-TF period of tolerance: without it, a window edge landing mid-period flags
// CLIPPED on a perfectly healthy chart and permanently suppresses Status OK.
int CLIP_TOL_MS = 1000 * timeframe.in_seconds(sigTF)
bool windowClipped = chartStartT > startDate + CLIP_TOL_MS
var int firstWinT = na
var int lastWinT  = na
var int fpCount = 0
var int fpHash  = 0
if act and wWin
    if na(firstWinT)
        firstWinT := wT
    lastWinT := wT
if act and wGo
    fpCount += 1
    fpHash := (fpHash * FP_MULT + math.round(wT / 1000) % FP_MOD) % FP_MOD

// ── Position bookkeeping & orders (all decisions inside the gate) ──────────────────────────
var float entryRef  = na
var float stopLevel = na
var int   barsHeld  = 0
bool inPos = strategy.position_size > 0

bool buyEvt  = false
bool exitEvt = false

if act
    // held-bars counter in SIGNAL-TF bars (fill bar counts 1, as in the validated engine)
    barsHeld := inPos ? barsHeld + 1 : 0
    // window force-flatten
    if not wWin and inPos
        strategy.close_all(comment="window end")
    // condition exits on the completed signal-TF bar → fill next bar's open (validated)
    bool meanTouch = inPos and wMean
    bool timedOut  = inPos and barsHeld >= timeStop_e
    if meanTouch or timedOut
        strategy.close("MR", comment = meanTouch ? "mean" : "time")
        exitEvt := true
    // Flat-only entry (chart-level rule, as in the validated engine) unless stacking is on.
    // When stacking adds to an existing position the hold clock is NOT restarted — otherwise
    // a run of dips would keep pushing the time stop out and the trade could never age out.
    if wGo and (stack_e or not inPos)
        strategy.entry("MR", strategy.long, qty=qtyShares)
        buyEvt := true
        entryRef  := wC
        stopLevel := wC - stopMult * wAtr
        if not inPos
            barsHeld := 0

// Disaster stop — the one RESTING order kept (validated engine has it too). Fills intrabar
// at chart granularity; anchored to the signal-TF close, refreshed while in the trade.
if inPos and not na(stopLevel)
    strategy.exit("MR-stop", from_entry="MR", stop=stopLevel)

// ── Chart output ───────────────────────────────────────────────────────────────────────────
plot(showLevels ? wTrend : na, "Trend (200, signal TF)", color=color.new(color.gray, 30), linewidth=2, style=plot.style_stepline)
plot(showLevels ? wExit : na, "Exit mean (10, signal TF)", color=color.new(color.teal, 40), style=plot.style_stepline)
plot(showLevels and inPos ? stopLevel : na, "Disaster stop", color=color.new(color.red, 40), style=plot.style_linebr)

bool shadeRelevant = timeframe.in_seconds() < timeframe.in_seconds(sigTF)
bgcolor(showGateShade and shadeRelevant and act ? color.new(color.aqua, 90) : na, title="Signal-TF close (gate fired)")
plot(fireCount, "DBG gate fires", display=display.data_window)
plot(periodCount, "DBG sigTF periods", display=display.data_window)
plot(fpCount, "DBG fingerprint count", display=display.data_window)
plot(act ? 1 : 0, "DBG act", display=display.data_window)
plot(na(wTC) ? na : (wTC - time_close) / 60000.0, "DBG engine-chart close delta (min)", display=display.data_window)

bool exitedBar = strategy.position_size[1] > 0 and strategy.position_size < strategy.position_size[1]
// Distinguish a DISASTER-STOP fill from a mean/time exit: a condition exit is issued as a
// market order that fills on a later bar, so track it until the position actually shrinks.
// (Without this, the "MR Stopped" alert fires on every exit — caught in review 2026-07-31.)
var bool condExitPending = false
if exitEvt
    condExitPending := true
bool stopFill = exitedBar and not condExitPending
if exitedBar
    condExitPending := false
plotshape(showSignals and buyEvt, "BUY", shape.labelup, location.belowbar, buyCol, text="BUY", textcolor=color.white, size=size.small)
plotshape(showSignals and (exitEvt or exitedBar), "EXIT", shape.labeldown, location.abovebar, exitCol, text="EXIT", textcolor=color.white, size=size.small)

// ── Alerts ─────────────────────────────────────────────────────────────────────────────────
alertcondition(buyEvt, "MR Buy", "[iAPE_MR_v5] BUY {{ticker}} @ {{close}} (RSI oversold in uptrend)")
alertcondition(exitEvt, "MR Exit", "[iAPE_MR_v5] EXIT {{ticker}} @ {{close}} (snapback / time stop)")
alertcondition(stopFill, "MR Stopped", "[iAPE_MR_v5] STOP {{ticker}} @ {{close}} (disaster stop)")

// ── Connector outputs (hidden) ─────────────────────────────────────────────────────────────
plot(inPos ? 1 : 0, "→ In MR position", color=color.new(color.gray, 100), display=display.none)
plot(buyEvt ? 1 : 0, "→ MR buy signal", color=color.new(color.green, 100), display=display.none)

// ── Market regime read-out (display only, frozen classifier — identical to iAPE v5) ───────
// WHY THIS CANNOT SHOW UNCONFIRMED DATA: every term is offset >=1 completed DAILY bar,
// lookahead_off. Display-only; constants frozen for byte-parity with switch_shadow.py.
regimeUp = request.security("SPY", "D",
     close[1] > ta.sma(close, 50)[1] and ta.sma(close, 50)[1] > ta.sma(close, 50)[6],
     lookahead=barmerge.lookahead_off)

// ── Fallback HUD label (a LABEL on purpose, not a table) ───────────────────────────────────
var label hud = na
if barstate.islast and showHud
    label.delete(hud)
    string hudTxt = "iAPE MR v5 · gate " + str.tostring(fireCount) + "/" + str.tostring(periodCount) +
         " · fp " + str.tostring(fpCount) + "·h" + str.tostring(fpHash) +
         " · trades " + str.tostring(strategy.closedtrades) +
         (windowClipped ? " · CLIPPED" : "") + (gateDead ? " · GATE DEAD" : "") +
         (fillsOffSpec ? " · CHART<SIG" : "")
    hud := label.new(bar_index, high, hudTxt, style=label.style_label_lower_left,
         color=color.new(color.black, 20), textcolor=color.white, size=size.normal)

// ── Diagnostics table (top right) ──────────────────────────────────────────────────────────
// 20 rows: fixed rows + up to 6 conditional warnings, with headroom. An out-of-range
// table.cell is a RUNTIME ERROR that kills every remaining drawing on the pane.
var table pt = table.new(position.top_right, 2, 20, frame_width=1,
     frame_color=color.new(color.gray, 40), border_width=1, border_color=color.new(color.gray, 80))
p_row(int r, string k, string v, color vcol) =>
    table.cell(pt, 0, r, k, text_color=color.new(color.white, 15), text_halign=text.align_right, bgcolor=color.new(color.black, 20), text_size=dashSize)
    table.cell(pt, 1, r, v, text_color=vcol, text_halign=text.align_left, bgcolor=color.new(color.black, 35), text_size=dashSize)

if barstate.islast and showParity
    grey  = color.new(color.white, 35)
    green = color.new(#26a69a, 0)
    red   = color.new(#ef5350, 0)
    amber = color.new(color.orange, 0)
    table.cell(pt, 0, 0, "iAPE MR v5", text_color=color.white, bgcolor=color.new(color.purple, 15), text_size=dashSize)
    table.cell(pt, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.new(color.purple, 15), text_size=dashSize)
    p_row(1, "Chart TF", timeframe.period, grey)
    p_row(2, "Signal TF", sigTF, grey)
    p_row(3, "Window start", na(firstWinT) ? "—" : str.format_time(firstWinT, "yyyy-MM-dd", "America/New_York"), grey)
    p_row(4, "Window end", na(lastWinT) ? "—" : str.format_time(lastWinT, "yyyy-MM-dd", "America/New_York"), grey)
    p_row(5, "Closed trades", str.tostring(strategy.closedtrades), grey)
    p_row(6, "Net profit", (strategy.netprofit >= 0 ? "+" : "") + str.tostring(strategy.netprofit, "#,###.##"), strategy.netprofit >= 0 ? green : red)
    p_row(7, "Fingerprint", str.tostring(fpCount) + " · h=" + str.tostring(fpHash), color.new(color.aqua, 0))
    p_row(8, "Gate fires", str.tostring(fireCount) + "/" + str.tostring(periodCount), fireCount > 0 ? grey : amber)
    p_row(9, "Timing", str.format_time(time_close, "MM-dd HH:mm", "America/New_York") + " vs " + (na(wTC) ? "na" : str.format_time(wTC, "MM-dd HH:mm", "America/New_York")), grey)
    // WHY ARE THERE NO BUYS? — the two rows that answer it without guesswork.
    p_row(10, "Uptrend bars", str.tostring(armedCount) + "/" + str.tostring(fireCount) + " above the " + str.tostring(trendLen_e) + "-bar trend", armedCount > 0 ? grey : amber)
    p_row(11, "RSI seen", "now " + (na(lastRsi) ? "—" : str.tostring(lastRsi, "#.#")) + " · lowest " + (na(minRsi) ? "—" : str.tostring(minRsi, "#.#")) + " · needs < " + str.tostring(rsiEntry_e, "#"),
         na(minRsi) ? grey : minRsi < rsiEntry_e ? grey : amber)
    int r = 12
    if not tfSupported
        p_row(r, "✖ ERROR", "chart TF > signal TF", red)
        r += 1
    if gateDead
        p_row(r, "✖ GATE DEAD", "0/" + str.tostring(periodCount) + " — try Arrival mode", red)
        r += 1
    if fillsOffSpec
        p_row(r, "⚠ CHART<SIG", "fills leave validated next-open semantics — run chart at " + sigTF, amber)
        r += 1
    if windowClipped
        p_row(r, "⚠ CLIPPED", "history " + str.format_time(chartStartT, "yyyy-MM-dd", "America/New_York"), amber)
        r += 1
    if lagCount > 0
        p_row(r, "⚠ MERGE LAG", "n=" + str.tostring(lagCount), amber)
        r += 1
    if offsetFires > 0
        p_row(r, "⚠ OFF-GRID TF", str.tostring(offsetFires) + " fires landed after (not on) the signal-TF close — this interval doesn't divide the session evenly. Signals fine; fills drift.", amber)
        r += 1
    if calendarWarn
        p_row(r, "⚠ CALENDAR", str.tostring(fireCount) + " fires vs " + str.tostring(periodCount) + " periods", amber)
        r += 1
    if fireCount > 0 and fpCount == 0
        p_row(r, "NO SIGNALS — WHY", not na(minRsi) and minRsi >= rsiEntry_e ?
             "never oversold enough: lowest RSI was " + str.tostring(minRsi, "#.#") + ", needs < " + str.tostring(rsiEntry_e, "#") + ". Loosen Signal frequency, or load more history." :
             armedCount == 0 ? "never above the " + str.tostring(trendLen_e) + "-bar trend in this window — MR stands aside in downtrends." :
             "oversold and in uptrend never coincided in this window.", amber)
        r += 1
    if tfSupported and not windowClipped and lagCount == 0 and not calendarWarn and not gateDead and not fillsOffSpec and offsetFires == 0
        p_row(r, "Status", "OK", green)

// ── Plain-English dashboard (bottom) ───────────────────────────────────────────────────────
var table dash = table.new(position.bottom_center, 2, 8, frame_width=1,
     frame_color=color.new(color.gray, 40), border_width=1, border_color=color.new(color.gray, 80))
f_row(int r, string k, string v, color vcol) =>
    table.cell(dash, 0, r, k, text_color=color.new(color.white, 15), text_halign=text.align_right, bgcolor=color.new(color.black, 20), text_size=dashSize)
    table.cell(dash, 1, r, v, text_color=vcol, text_halign=text.align_left, bgcolor=color.new(color.black, 35), text_size=dashSize)

if barstate.islast and showDash
    grey  = color.new(color.white, 35)
    green = color.new(#26a69a, 0)
    red   = color.new(#ef5350, 0)
    table.cell(dash, 0, 0, "iAPE MR v5", text_color=color.white, bgcolor=color.new(color.purple, 15), text_size=dashSize)
    table.cell(dash, 1, 0, syminfo.ticker + " · signals on " + sigTF, text_color=color.white, bgcolor=color.new(color.purple, 15), text_size=dashSize)
    string nowTxt = inPos ? "HOLDING — waiting for snapback (held " + str.tostring(barsHeld) + "/" + str.tostring(timeStop_e) + ")" :
         wRegime ? "Armed — RSI " + str.tostring(wRsi, "#.#") + " (buys under " + str.tostring(rsiEntry_e, "#") + ")" :
         "Stand aside — below the " + str.tostring(trendLen_e) + "-bar trend"
    f_row(1, "Right now", nowTxt, inPos ? green : grey)
    f_row(2, "Frequency preset", (isValidCfg ? "VALIDATED · " : isCustomCfg ? "CUSTOM (unvalidated) · " : isMaxCfg ? "MAXIMUM (barely filtered) · " : "LOOSENED (unvalidated) · ") +
         "RSI(" + str.tostring(rsiLen_e) + ")<" + str.tostring(rsiEntry_e, "#") +
         " · trend " + (useTrend_e ? str.tostring(trendLen_e) : "OFF — buys dips in DOWNtrends too") +
         " · stop " + str.tostring(timeStop_e) + "b" + (stack_e ? " · STACKING x4" : ""),
         isValidCfg ? green : isMaxCfg ? red : color.new(color.orange, 0))
    tot = strategy.closedtrades
    wr  = tot > 0 ? 100.0 * strategy.wintrades / tot : na
    f_row(3, "Trades on this chart", str.tostring(tot) + (tot > 0 ? " (won " + str.tostring(wr, "#.#") + "% — MR should be ~64%)" : "") +
         (fillsOffSpec ? "  ⚠ short history: run on a " + sigTF + " chart for full history" : ""), grey)
    gp = strategy.grossprofit
    gl = strategy.grossloss
    pf = gl > 0 ? gp / gl : na
    f_row(4, "Profit factor", na(pf) ? "—" : str.tostring(pf, "#.##"), na(pf) ? grey : pf >= 1.2 ? green : pf >= 0.95 ? grey : red)
    f_row(5, "Symbol fit", "MR dies on momentum leaders — NVDA/AAPL negative 30y; PRI measured NEGATIVE (2026-07-30)", color.new(color.orange, 0))
    f_row(6, "This engine", isValidCfg ? "one chart runs RICHER than the validated portfolio (PF 1.2-1.4) — judge per symbol, ≥30 trades" :
         "LOOSENED SETTINGS — this is exploration, not the validated engine; its numbers prove nothing", isValidCfg ? grey : color.new(color.orange, 0))
    if showRegime
        f_row(7, "Market regime", regimeUp ? "MOMENTUM weather (label only)" : "MEAN-REVERSION weather (label only)", grey)
