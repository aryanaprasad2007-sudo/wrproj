// © @Apeaverage & @SXDXST_FB6 (Impulse MACD)  •  Refined by Akash (SMA/RSI/MACD)
// Combined into one strategy and migrated to Pine v6.
//
// WHAT THIS IS
//   A single backtestable strategy that fuses the two scripts:
//     • System A — Impulse MACD: ZLEMA of hlc3 vs an SMMA high/low channel, with a signal line.
//     • System B — SMA/RSI/MACD: MACD/signal cross gated by an RSI threshold.
//   Trade style carried over from before: scalp, ALWAYS-IN reversal, exit only on the opposite
//   signal (no stop/target). Long & short, each toggleable, optional session window.
//
//   SIGNAL MODE (input):
//     • "Confluence (all agree)" (default) — enter long only when Impulse (md>sb) AND MACD>signal
//       AND RSI<buyThreshold are ALL true, firing on the bar they first agree. Fewer, cleaner trades.
//     • "Either signal" — enter when EITHER system's cross fires. More trades, more noise.
//
//   Costs (commission/slippage) are baked into the header — tune them to your venue before trusting
//   any backtest. Scalping results are dominated by fees.

//@version=6
strategy("Impulse MACD + SMA/RSI/MACD Combo", shorttitle="IMACD_SRM", overlay=true,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     pyramiding              = 0,
     process_orders_on_close = true,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.04,
     slippage                = 2)

// ── Inputs: Impulse MACD ───────────────────────────────────────────────────────────
g1 = "Impulse MACD"
lengthMA     = input.int(34, "Channel / MA length", minval=1, group=g1)
lengthSignal = input.int(9,  "Impulse signal length", minval=1, group=g1)

// ── Inputs: SMA / RSI / MACD ────────────────────────────────────────────────────────
g2 = "SMA / RSI / MACD"
smaLength        = input.int(10, "SMA length", minval=1, group=g2)
rsiLength        = input.int(14, "RSI length", minval=1, group=g2)
rsiBuyThreshold  = input.int(35, "RSI buy threshold", group=g2)
rsiSellThreshold = input.int(65, "RSI sell threshold", group=g2)
fastLength       = input.int(12, "MACD fast", minval=1, group=g2)
slowLength       = input.int(26, "MACD slow", minval=1, group=g2)
signalLength     = input.int(9,  "MACD signal", minval=1, group=g2)

// ── Inputs: Combo & trading ─────────────────────────────────────────────────────────
g3 = "Combo & trading"
mode       = input.string("Confluence (all agree)", "Signal mode", options=["Confluence (all agree)", "Either signal"], group=g3, tooltip="Confluence = all three (Impulse, MACD, RSI) must agree. Either = trade when either system fires.")
tradeLong  = input.bool(true,  "Allow longs",  group=g3)
tradeShort = input.bool(true,  "Allow shorts", group=g3)
useSession = input.bool(false, "Restrict to session", group=g3)
sess       = input.session("0930-1600", "Session (exchange time)", group=g3)

// ── Functions ───────────────────────────────────────────────────────────────────────
// Smoothed MA (Wilder's): seed with SMA then recursively smooth.
calc_smma(src, len) =>
    var float smma = na
    smma := na(smma[1]) ? ta.sma(src, len) : (smma[1] * (len - 1) + src) / len
    smma

// Zero-Lag EMA: add the EMA-of-EMA error back to cancel lag.
calc_zlema(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    ema1 + (ema1 - ema2)

// ── System A: Impulse MACD ──────────────────────────────────────────────────────────
src = hlc3
hi  = calc_smma(high, lengthMA)
lo  = calc_smma(low,  lengthMA)
mi  = calc_zlema(src, lengthMA)
md  = mi > hi ? mi - hi : mi < lo ? mi - lo : 0.0
sb  = ta.sma(md, lengthSignal)

// ── System B: SMA / RSI / MACD ──────────────────────────────────────────────────────
smaValue = ta.sma(close, smaLength)
rsiValue = ta.rsi(close, rsiLength)
[macdValue, signalValue, _] = ta.macd(close, fastLength, slowLength, signalLength)

// ── Combine the two systems ─────────────────────────────────────────────────────────
isConfluence = mode == "Confluence (all agree)"

// Confluence: all three bullish/bearish, fire on the bar agreement first appears.
longState  = (md > sb) and (macdValue > signalValue) and (rsiValue < rsiBuyThreshold)
shortState = (md < sb) and (macdValue < signalValue) and (rsiValue > rsiSellThreshold)
confLong   = longState  and not longState[1]
confShort  = shortState and not shortState[1]

// Either: trade when either system's cross fires.
eitherLong  = ta.crossover(md, sb)  or (ta.crossover(macdValue, signalValue)  and rsiValue < rsiBuyThreshold)
eitherShort = ta.crossunder(md, sb) or (ta.crossunder(macdValue, signalValue) and rsiValue > rsiSellThreshold)

longSignal  = isConfluence ? confLong  : eitherLong
shortSignal = isConfluence ? confShort : eitherShort

// Guard against a rare same-bar long+short collision (only possible in "Either" mode).
conflict = longSignal and shortSignal
goLong   = longSignal  and not conflict
goShort  = shortSignal and not conflict

// ── Session gate ────────────────────────────────────────────────────────────────────
inSession = not useSession or not na(time(timeframe.period, sess))

// ── Orders: always-in reversal; the opposite signal IS the exit ─────────────────────
if inSession
    if goLong and tradeLong
        strategy.entry("Long", strategy.long)
    if goShort and tradeShort
        strategy.entry("Short", strategy.short)
// If a direction is disabled, still flatten on its signal.
if goShort and not tradeShort
    strategy.close("Long")
if goLong and not tradeLong
    strategy.close("Short")
// Flatten when the session window closes.
if useSession and not inSession
    strategy.close_all(comment="Session end")

// ── Plots (all price-scale → overlay) ───────────────────────────────────────────────
plot(hi,       "Impulse upper band", color=color.new(color.teal,   50))
plot(lo,       "Impulse lower band", color=color.new(color.maroon, 50))
plot(mi,       "ZLEMA (hlc3)",       color=color.new(color.blue,   0), linewidth=2)
plot(smaValue, "SMA",                color=color.new(color.orange, 0))

plotshape(goLong,  "Buy",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(goShort, "Sell", shape.triangledown, location.abovebar, color.new(color.red,   0), size=size.small)

// RSI/MACD are used as logic only (they don't share price scale, so they're not plotted here).
// Exact values are in the Data Window.

// ── Alerts ──────────────────────────────────────────────────────────────────────────
alertcondition(goLong,  "Combo Buy",  "Combo BUY: systems agree (long)")
alertcondition(goShort, "Combo Sell", "Combo SELL: systems agree (short)")
