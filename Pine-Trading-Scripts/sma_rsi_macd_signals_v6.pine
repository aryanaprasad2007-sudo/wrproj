//
// SMA + RSI + MACD signal indicator.
//   Buy  = MACD crosses ABOVE its signal line  AND  RSI is below the buy threshold (oversold-ish)
//   Sell = MACD crosses BELOW its signal line  AND  RSI is above the sell threshold (overbought-ish)
//
// ── CHANGELOG (v5 → v6) ────────────────────────────────────────────────────────
//  1. //@version=5 → //@version=6  (v6 is the current latest Pine version, no v7 exists).
//  2. FIXED THE OVERLAY BUG: the original was overlay=true and plotted RSI (0–100) and MACD
//     (small values around 0) ON TOP OF PRICE, where they're unreadable. Now the indicator
//     lives in its own pane (overlay=false); the SMA line and the buy/sell arrows are pushed
//     onto the price chart with force_overlay=true. RSI/MACD stay where they belong.
//  3. RSI can't share a value scale with MACD in one pane, so its filter state is shown as a
//     background tint (green = RSI below buy threshold, red = RSI above sell threshold) instead
//     of a mis-scaled line. Exact RSI is still in the Data Window. (Want RSI as a full 0–100
//     line? It needs its own pane — say the word and I'll split it into a second indicator.)
//  4. Captured the MACD histogram (was discarded as `_`) and plotted it for context.
//  5. Added alertcondition() for Buy and Sell so you can wire up TradingView alerts.
//  Logic note: this script had NO implicit int/float→bool casts, so v6's strict-boolean rule
//  required no logic changes — the conditions are identical to the original.

//@version=6
indicator("SMA + RSI + MACD Signals", shorttitle="SRM_Signals", overlay=false)

// ── Inputs ──────────────────────────────────────────────────────────────────────
smaLength        = input.int(10, title='SMA Length')
rsiLength        = input.int(14, title='RSI Length')
rsiBuyThreshold  = input.int(35, title='RSI Buy Threshold')
rsiSellThreshold = input.int(65, title='RSI Sell Threshold')
fastLength       = input.int(12, title="MACD Fast Length")
slowLength       = input.int(26, title="MACD Slow Length")
signalLength     = input.int(9,  title="MACD Signal Length")

// ── Calculations (unchanged) ──────────────────────────────────────────────────────
smaValue = ta.sma(close, smaLength)
rsiValue = ta.rsi(close, rsiLength)
[macdValue, signalValue, histValue] = ta.macd(close, fastLength, slowLength, signalLength)

// ── Conditions (identical logic to the original) ──────────────────────────────────
buyCondition  = ta.crossover(macdValue, signalValue)  and rsiValue < rsiBuyThreshold
sellCondition = ta.crossunder(macdValue, signalValue) and rsiValue > rsiSellThreshold

// ── On the PRICE chart (forced overlay) ───────────────────────────────────────────
plot(smaValue, title='SMA', color=color.orange, force_overlay=true)

plotshape(buyCondition ? close : na, title='Buy Signal', style=shape.triangleup,
     location=location.belowbar, color=color.rgb(1, 240, 9), size=size.large, force_overlay=true)
plotshape(sellCondition ? close : na, title='Sell Signal', style=shape.triangledown,
     location=location.abovebar, color=color.rgb(245, 16, 188), size=size.large, force_overlay=true)

// ── In THIS indicator's pane: MACD ────────────────────────────────────────────────
plot(histValue,   title='MACD Histogram', color=(histValue >= 0 ? color.new(color.green, 60) : color.new(color.red, 60)), style=plot.style_columns)
plot(macdValue,   title='MACD',   color=color.green)
plot(signalValue, title='Signal', color=color.red)
hline(0, title='Zero', color=color.gray, linestyle=hline.style_dotted)

// RSI filter, shown as a background tint (can't plot a 0–100 line in a MACD-scaled pane)
bgcolor(rsiValue < rsiBuyThreshold  ? color.new(color.green, 88) : na, title='RSI buy zone')
bgcolor(rsiValue > rsiSellThreshold ? color.new(color.red,   88) : na, title='RSI sell zone')

// ── Alerts ────────────────────────────────────────────────────────────────────────
alertcondition(buyCondition,  title='Buy Signal',  message='SRM: BUY — MACD crossed up & RSI < buy threshold')
alertcondition(sellCondition, title='Sell Signal', message='SRM: SELL — MACD crossed down & RSI > sell threshold')
