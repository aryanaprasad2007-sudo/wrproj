# --- required everywhere ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- service ---------------------------------------------------------------
# Shared secret between the service and its clients. The service will not start
# without it. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
ASSISTANT_TOKEN=

# Leave as 127.0.0.1 unless you know what sits between this and the internet.
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8000

# Optional
# PERSONA_PATH=persona/rei.yaml
# ASSISTANT_STORE=data/conversations.json
# ASSISTANT_MAX_TURNS=40

# --- telegram bot ----------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to talk to her. Anyone who finds the bot's
# username can message it, so this is not optional in practice — with it empty
# the bot answers nobody and logs the id of whoever wrote, so you can add yours.
TELEGRAM_ALLOWED_CHAT_IDS=

# Where the bot finds the service. Change if they're on different machines.
ASSISTANT_URL=http://127.0.0.1:8000

# --- voice conversation (phase 3) ------------------------------------------
# Silence that ends an utterance. The biggest latency lever in the pipeline:
# dead time on every turn. Too low cuts you off mid-sentence.
# END_SILENCE_MS=600
# PRE_ROLL_MS=300
# VAD_AGGRESSIVENESS=2      # 0-3, higher rejects more background noise
# BARGE_IN=1                # set 0 if using speakers rather than headphones

# --- memory and reminders (phase 4) ----------------------------------------
# Where memory.json and reminders.json live. Both are plain, editable JSON.
# ASSISTANT_DATA=data

# --- the face (phase 5) ----------------------------------------------------
# Open http://127.0.0.1:8000/avatar#token=<ASSISTANT_TOKEN> while she talks.
# The voice clients report playback so the mouth stays in step with the audio;
# set this to 0 to stop them reporting anything at all.
# AVATAR=1
